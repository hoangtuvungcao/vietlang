// ========================================================================
// Module: std.rate_limiter
// Configurable Enterprise Sliding-Window Rate Limiter Engine
// ========================================================================

/// Khoi tao bo gioi han tan suat yeu cau (Rate Limiter)
/// @param max_requests: Int - So luong request toi da cho phep trong 1 cua so thoi gian
/// @param window_seconds: Int - Do dai cua so thoi gian (giay)
/// @return Map - Rate limiter instance
fn rate_limiter_new(max_requests: Int = 100, window_seconds: Int = 60) {
    let mut rl = map_new()
    rl = map_set(rl, "max_requests", max_requests)
    rl = map_set(rl, "window_seconds", window_seconds)
    rl = map_set(rl, "records", map_new())
    rl = map_set(rl, "whitelist", [])
    return rl
}

/// Them dia chi IP hoac API key vao danh sach trang bo qua rate limit
/// @param rl: Map - Rate limiter instance
/// @param ip: String - Dia chi IP hoac API key
/// @return Map - Rate limiter instance cap nhat
fn rate_limiter_whitelist(rl, ip: String) {
    let list = map_get(rl, "whitelist")
    let new_list = push(list, ip)
    return map_set(rl, "whitelist", new_list)
}

/// Kiem tra xem key co nam trong danh sach trang khong
/// @param rl: Map - Rate limiter instance
/// @param key: String - IP can kiem tra
/// @return Bool - True neu duoc whitelist
fn rate_limiter_is_whitelisted(rl, key: String) -> Bool {
    let list = map_get(rl, "whitelist")
    if list == none {
        return false
    }
    let mut i = 0
    while i < len(list) {
        if list[i] == key {
            return true
        }
        i = i + 1
    }
    return false
}

/// Kiem tra va ghi nhan request theo thuat toan Sliding-Window
/// @param rl: Map - Rate limiter instance
/// @param key: String - IP hoac Token can kiem tra
/// @return Map - Ket qua { allowed: Bool, remaining: Int, limiter: Map }
fn rate_limiter_check(rl, key: String) {
    if rate_limiter_is_whitelisted(rl, key) {
        let mut allow_res = map_new()
        allow_res = map_set(allow_res, "allowed", true)
        allow_res = map_set(allow_res, "remaining", map_get(rl, "max_requests"))
        allow_res = map_set(allow_res, "reset_in", 0)
        allow_res = map_set(allow_res, "limiter", rl)
        return allow_res
    }

    let now = time_now()
    let max_req = map_get(rl, "max_requests")
    let window = map_get(rl, "window_seconds")

    let mut records = map_get(rl, "records")
    let mut timestamps = []
    if map_has(records, key) {
        timestamps = map_get(records, key)
    }

    // Retain only timestamps within sliding window
    let mut valid_timestamps = []
    let mut i = 0
    while i < len(timestamps) {
        let t = timestamps[i]
        if (now - t) < window {
            valid_timestamps = push(valid_timestamps, t)
        }
        i = i + 1
    }

    let count = len(valid_timestamps)
    let is_allowed = count < max_req

    if is_allowed {
        valid_timestamps = push(valid_timestamps, now)
    }

    records = map_set(records, key, valid_timestamps)
    let updated_rl = map_set(rl, "records", records)

    let remaining = max_req - len(valid_timestamps)
    let mut reset_in = window
    if len(valid_timestamps) > 0 {
        let oldest = valid_timestamps[0]
        reset_in = window - (now - oldest)
        if reset_in < 0 {
            reset_in = 0
        }
    }

    let mut result = map_new()
    result = map_set(result, "allowed", is_allowed)
    result = map_set(result, "remaining", remaining)
    result = map_set(result, "reset_in", reset_in)
    result = map_set(result, "limiter", updated_rl)
    return result
}
