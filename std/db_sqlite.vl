// ========================================================================
// VietLang Experimental SQLite Adapter (std.db_sqlite)
// Real Binary File-Backed ACID Relational Database with WAL Mode
// ========================================================================

fn sqlite_open(db_path: String = "data/database.sqlite") {
    return builtin_sqlite_open(db_path)
}

fn sqlite_exec(conn, sql: String) {
    builtin_sqlite_exec(conn, sql)
    return conn
}

fn sqlite_execute(conn, sql: String, params = []) {
    return builtin_sqlite_execute(conn, sql, params)
}

fn sqlite_query(conn, sql_or_table: String, params_or_filter = []) {
    let s = sql_or_table.trim()
    if s.starts_with("SELECT ") || s.starts_with("select ") || s.starts_with("PRAGMA ") || s.starts_with("pragma ") || s.starts_with("EXPLAIN ") {
        return builtin_sqlite_query(conn, sql_or_table, params_or_filter)
    }

    // It is a table name lookup:
    let sql = "SELECT * FROM " + sql_or_table + ";"
    let rows = builtin_sqlite_query(conn, sql, [])
    if type_of(params_or_filter) == "Function" {
        let mut matched = []
        for r in rows {
            if params_or_filter(r) {
                matched = push(matched, r)
            }
        }
        return matched
    }
    return rows
}

fn sqlite_close(conn) {
    return builtin_sqlite_close(conn)
}

fn sqlite_begin_transaction(conn) {
    builtin_sqlite_exec(conn, "BEGIN TRANSACTION;")
    return conn
}

fn sqlite_commit(conn) {
    builtin_sqlite_exec(conn, "COMMIT;")
    return conn
}

fn sqlite_rollback(conn) {
    builtin_sqlite_exec(conn, "ROLLBACK;")
    return conn
}

fn sqlite_insert(conn, table_name: String, row_data) {
    let keys = map_keys(row_data)
    if keys.len() == 0 {
        return 0
    }

    let mut cols_str = ""
    let mut placeholders_str = ""
    let mut vals = []

    let mut i = 0
    while i < keys.len() {
        let k = keys[i]
        let v = map_get(row_data, k)
        vals = push(vals, v)

        if i == 0 {
            cols_str = cols_str + k
            placeholders_str = placeholders_str + "?"
        } else {
            cols_str = cols_str + ", " + k
            placeholders_str = placeholders_str + ", ?"
        }
        i = i + 1
    }

    let sql = "INSERT OR REPLACE INTO " + table_name + " (" + cols_str + ") VALUES (" + placeholders_str + ");"
    sqlite_execute(conn, sql, vals)
    return conn
}

fn sqlite_update(conn, table_name: String, predicate_fn_or_id, update_fn_or_map) {
    if type_of(predicate_fn_or_id) == "Int" || type_of(predicate_fn_or_id) == "String" {
        let id_val = predicate_fn_or_id
        let keys = map_keys(update_fn_or_map)
        let mut set_str = ""
        let mut vals = []
        let mut i = 0
        while i < keys.len() {
            let k = keys[i]
            let v = map_get(update_fn_or_map, k)
            vals = push(vals, v)
            if i == 0 {
                set_str = set_str + k + " = ?"
            } else {
                set_str = set_str + ", " + k + " = ?"
            }
            i = i + 1
        }
        vals = push(vals, id_val)
        let sql = "UPDATE " + table_name + " SET " + set_str + " WHERE id = ?;"
        sqlite_execute(conn, sql, vals)
        return conn
    }

    // Dynamic callback update
    let rows = sqlite_query(conn, "SELECT * FROM " + table_name + ";", [])
    for r in rows {
        if predicate_fn_or_id(r) {
            let updated = update_fn_or_map(r)
            sqlite_insert(conn, table_name, updated)
        }
    }
    return conn
}

fn sqlite_delete(conn, table_name: String, predicate_fn_or_id) {
    if type_of(predicate_fn_or_id) == "Int" || type_of(predicate_fn_or_id) == "String" {
        let sql = "DELETE FROM " + table_name + " WHERE id = ?;"
        sqlite_execute(conn, sql, [predicate_fn_or_id])
        return conn
    }

    let rows = sqlite_query(conn, "SELECT * FROM " + table_name + ";", [])
    for r in rows {
        if predicate_fn_or_id(r) {
            let id = map_get(r, "id")
            sqlite_execute(conn, "DELETE FROM " + table_name + " WHERE id = ?;", [id])
        }
    }
    return conn
}

fn sqlite_find_by_id(conn, table_name: String, id) {
    let sql = "SELECT * FROM " + table_name + " WHERE id = ? LIMIT 1;"
    let rows = sqlite_query(conn, sql, [id])
    if rows.len() > 0 {
        return rows[0]
    }
    return none
}

fn sqlite_count(conn, table_name: String, where_clause: String = "") {
    let mut sql = "SELECT COUNT(*) as count FROM " + table_name
    if where_clause != "" {
        sql = sql + " WHERE " + where_clause
    }
    let rows = builtin_sqlite_query(conn, sql, [])
    if rows.len() > 0 {
        let r = rows[0]
        return map_get(r, "count")
    }
    return 0
}

fn sqlite_aggregate(conn, table_name: String, initial_val, acc_fn) {
    let rows = sqlite_query(conn, table_name, none)
    let mut acc = initial_val
    for r in rows {
        acc = acc_fn(acc, r)
    }
    return acc
}
