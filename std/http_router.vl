// ===================================================
// VietLang HTTP Router & Web Framework (std.http_router)
// Written in pure VietLang
// ===================================================

fn router_new() {
    let r = map_new()
    let r = map_set(r, "routes", [])
    let r = map_set(r, "middlewares", [])
    return r
}

fn router_add_route(r, method: String, path: String, handler_name: String) {
    let route = map_new()
    let route = map_set(route, "method", method)
    let route = map_set(route, "path", path)
    let route = map_set(route, "handler", handler_name)

    let current_routes = map_get(r, "routes")
    let new_routes = push(current_routes, route)
    return map_set(r, "routes", new_routes)
}

fn router_use(r, middleware_name: String) {
    let current_mw = map_get(r, "middlewares")
    let new_mw = push(current_mw, middleware_name)
    return map_set(r, "middlewares", new_mw)
}

fn http_serve_static(public_dir: String, req_path: String) {
    if req_path == "/docs" || req_path == "/swagger" {
        let swagger_html = "<!DOCTYPE html><html><head><meta charset='UTF-8'><title>VietLang API Explorer — Swagger UI</title><link rel='stylesheet' href='https://unpkg.com/swagger-ui-dist@5.11.0/swagger-ui.css'><style>body{margin:0;background:#0b160f;font-family:sans-serif;} .topbar{display:none;} .swagger-ui{background:#070d09;color:#e2e8f0;padding:24px;} .swagger-ui .info .title{color:#10b981;font-weight:800;}</style></head><body><div id='swagger-ui'></div><script src='https://unpkg.com/swagger-ui-dist@5.11.0/swagger-ui-bundle.js'></script><script>window.onload=()=>{SwaggerUIBundle({url:'/api/v1/swagger.json',dom_id:'#swagger-ui',deepLinking:true});};</script></body></html>"
        let mut resp = map_new()
        resp = map_set(resp, "status_code", 200)
        resp = map_set(resp, "content_type", "text/html; charset=utf-8")
        resp = map_set(resp, "body", swagger_html)
        return resp
    }

    let mut file_path = public_dir + req_path
    if req_path == "/" || req_path == "" {
        file_path = public_dir + "/index.html"
    }

    if file_exists(file_path) {
        let content = file_read(file_path)
        let mut ct = "text/plain; charset=utf-8"
        if file_path.ends_with(".html") {
            ct = "text/html; charset=utf-8"
        }
        if file_path.ends_with(".css") {
            ct = "text/css; charset=utf-8"
        }
        if file_path.ends_with(".js") {
            ct = "application/javascript; charset=utf-8"
        }
        if file_path.ends_with(".json") {
            ct = "application/json; charset=utf-8"
        }
        if file_path.ends_with(".svg") {
            ct = "image/svg+xml; charset=utf-8"
        }
        if file_path.ends_with(".ico") {
            ct = "image/x-icon"
        }

        let mut resp = map_new()
        resp = map_set(resp, "status_code", 200)
        resp = map_set(resp, "content_type", ct)
        resp = map_set(resp, "body", content)
        return resp
    }

    return none
}

fn response_json(status: Int, data, message: String = "OK") -> String {
    let resp = map_new()
    let resp = map_set(resp, "status", status)
    let resp = map_set(resp, "message", message)
    let resp = map_set(resp, "data", data)
    let resp = map_set(resp, "timestamp", time_now())
    return json_stringify(resp, true)
}

fn response_error(status: Int, error_msg: String) -> String {
    let resp = map_new()
    let resp = map_set(resp, "status", status)
    let resp = map_set(resp, "error", error_msg)
    let resp = map_set(resp, "timestamp", time_now())
    return json_stringify(resp, true)
}
