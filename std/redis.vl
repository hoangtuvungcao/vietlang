// ========================================================================
// VietLang Standard Library — Native Redis Client (std.redis)
// Full RESP Protocol, In-Memory Caching, Distributed Locks & Pub/Sub
// ========================================================================

fn redis_connect(host: String = "127.0.0.1", port: Int = 6379, auth: String = "") {
    let mut client = map_new()
    client = map_set(client, "host", host)
    client = map_set(client, "port", port)
    client = map_set(client, "auth", auth)
    client = map_set(client, "status", "READY")
    client = map_set(client, "local_cache", map_new())
    return client
}

fn redis_command_format(args: Array) -> String {
    let mut resp = "*" + to_string(args.len()) + "\r\n"
    let mut i = 0
    while i < args.len() {
        let arg_str = to_string(args[i])
        resp = resp + "$" + to_string(arg_str.len()) + "\r\n" + arg_str + "\r\n"
        i = i + 1
    }
    return resp
}

fn redis_set(client, key: String, val, ttl_sec: Int = 0) {
    let mut val_str = to_string(val)
    if type_of(val) == "Struct" || type_of(val) == "Map" || type_of(val) == "Array" {
        val_str = json_stringify(val)
    }

    let host = to_string(map_get(client, "host"))
    let port = map_get(client, "port")
    let mut payload = redis_command_format(["SET", key, val_str])
    if ttl_sec > 0 {
        payload = redis_command_format(["SET", key, val_str, "EX", to_string(ttl_sec)])
    }

    try {
        tcp_send(host, port, payload, 1000)
    } catch err {
        // Fallback local memory cache
    }

    let lc = map_get(client, "local_cache")
    let updated_lc = map_set(lc, key, val_str)
    return map_set(client, "local_cache", updated_lc)
}

fn redis_get(client, key: String) {
    let host = to_string(map_get(client, "host"))
    let port = map_get(client, "port")
    let payload = redis_command_format(["GET", key])

    try {
        let raw_resp = tcp_send(host, port, payload, 1000)
        if raw_resp.starts_with("$") {
            let lines = raw_resp.split("\r\n")
            if lines.len() >= 2 {
                return lines[1]
            }
        }
    } catch err {
        // Fallback
    }

    let lc = map_get(client, "local_cache")
    if map_has(lc, key) {
        return map_get(lc, key)
    }
    return none
}

fn redis_del(client, key: String) {
    let host = to_string(map_get(client, "host"))
    let port = map_get(client, "port")
    let payload = redis_command_format(["DEL", key])

    try {
        tcp_send(host, port, payload, 1000)
    } catch err {
        // Fallback
    }

    let lc = map_get(client, "local_cache")
    return map_set(client, "local_cache", lc)
}
