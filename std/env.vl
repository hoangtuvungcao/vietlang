// ========================================================================
// VietLang Enterprise Environment & Secrets Management (std.env)
// .env File Parser, Variable Coercion, and Config Validation
// ========================================================================

fn env_load_file(path: String = ".env") {
    let content = file_read(path)
    if content == "" {
        return false
    }

    let lines = content.split("\n")
    for line in lines {
        let trimmed = line.trim()
        if trimmed != "" && !trimmed.starts_with("#") && trimmed.contains("=") {
            let eq_pos = trimmed.find("=")
            if eq_pos > 0 {
                let key = trimmed.slice(0, eq_pos).trim()
                let mut val = trimmed.slice(eq_pos + 1, trimmed.len()).trim()
                if (val.starts_with("\"") && val.ends_with("\"")) || (val.starts_with("'") && val.ends_with("'")) {
                    val = val.slice(1, val.len() - 1)
                }
                env_set(key, val)
            }
        }
    }
    return true
}

fn env_get_str(key: String, default_val: String = "") -> String {
    let v = env_get(key)
    if v == "" || v == none {
        return default_val
    }
    return to_string(v)
}

fn env_get_int(key: String, default_val: Int = 0) -> Int {
    let v = env_get(key)
    if v == "" || v == none {
        return default_val
    }
    return to_int(v)
}

fn env_get_bool(key: String, default_val: Bool = false) -> Bool {
    let v = env_get(key)
    if v == "" || v == none {
        return default_val
    }
    let s = to_string(v).to_lower()
    return s == "true" || s == "1" || s == "yes"
}

fn env_require(key: String) -> String {
    let v = env_get(key)
    if v == "" || v == none {
        println("[CRITICAL ERROR] Missing required environment variable: " + key)
        return ""
    }
    return to_string(v)
}
