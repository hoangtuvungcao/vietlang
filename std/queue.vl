// ========================================================================
// Module: std.queue
// Asynchronous Job Queue & Background Task Worker Engine
// ========================================================================

fn queue_new(name: String = "default_queue") {
    let mut q = map_new()
    q = map_set(q, "name", name)
    q = map_set(q, "jobs", [])
    q = map_set(q, "processed_count", 0)
    return q
}

fn queue_push(q, job_type: String, payload_map) {
    let mut job = map_new()
    job = map_set(job, "id", "job_" + to_string(time_now()))
    job = map_set(job, "type", job_type)
    job = map_set(job, "payload", payload_map)
    job = map_set(job, "created_at", time_now())
    job = map_set(job, "status", "QUEUED")

    let jobs = map_get(q, "jobs")
    let new_jobs = push(jobs, job)
    return map_set(q, "jobs", new_jobs)
}

fn queue_size(q) -> Int {
    let jobs = map_get(q, "jobs")
    if jobs == none {
        return 0
    }
    return len(jobs)
}

fn queue_pop(q) {
    let jobs = map_get(q, "jobs")
    if jobs == none || len(jobs) == 0 {
        let mut empty_res = map_new()
        empty_res = map_set(empty_res, "job", none)
        empty_res = map_set(empty_res, "queue", q)
        return empty_res
    }

    let first_job = jobs[0]
    let mut remaining = []
    let mut i = 1
    while i < len(jobs) {
        remaining = push(remaining, jobs[i])
        i = i + 1
    }

    let mut updated_q = map_set(q, "jobs", remaining)
    let processed = map_get(q, "processed_count") + 1
    updated_q = map_set(updated_q, "processed_count", processed)

    let mut res = map_new()
    res = map_set(res, "job", first_job)
    res = map_set(res, "queue", updated_q)
    return res
}
