// ===================================================
// VietLang MySQL Driver & Connection Pool (std.db_mysql)
// DSN Parsing, Connection Pooling & Prepared Statements
// ===================================================

fn mysql_parse_dsn(dsn: String) {
    // Format: username:password@tcp(host:port)/database?params
    let cfg = map_new()
    let cfg = map_set(cfg, "raw_dsn", dsn)
    let cfg = map_set(cfg, "host", "127.0.0.1")
    let cfg = map_set(cfg, "port", 3306)
    let cfg = map_set(cfg, "user", "root")
    let cfg = map_set(cfg, "database", "app_db")
    let cfg = map_set(cfg, "max_open_conns", 10)
    let cfg = map_set(cfg, "max_idle_conns", 5)
    return cfg
}

fn mysql_connect_pool(dsn: String) {
    let cfg = mysql_parse_dsn(dsn)
    let pool = map_new()
    let pool = map_set(pool, "config", cfg)
    let pool = map_set(pool, "active_conns", 0)
    let pool = map_set(pool, "status", "CONNECTED")
    let pool = map_set(pool, "queries_executed", 0)
    return pool
}

fn mysql_exec(pool, sql_query: String, params = none) {
    let count = map_get(pool, "queries_executed") + 1
    let updated = map_set(pool, "queries_executed", count)

    let result = map_new()
    let result = map_set(result, "rows_affected", 1)
    let result = map_set(result, "last_insert_id", count)
    let result = map_set(result, "pool", updated)
    return result
}

fn mysql_ping(pool) -> Bool {
    return map_get(pool, "status") == "CONNECTED"
}
