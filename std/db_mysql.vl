// ========================================================================
// VietLang MySQL Enterprise Driver (std.db_mysql)
// Real Binary MySQL 8.x / MariaDB Connection Pool, Transactions & Prepared SQL
// ========================================================================

fn mysql_parse_dsn(dsn: String) {
    let mut cfg = map_new()
    cfg = map_set(cfg, "raw_dsn", dsn)
    cfg = map_set(cfg, "host", "127.0.0.1")
    cfg = map_set(cfg, "port", 3306)
    cfg = map_set(cfg, "user", "root")
    cfg = map_set(cfg, "database", "")
    cfg = map_set(cfg, "max_open_conns", 50)
    cfg = map_set(cfg, "max_idle_conns", 10)
    cfg = map_set(cfg, "conn_max_lifetime_sec", 300)
    cfg = map_set(cfg, "charset", "utf8mb4")

    if dsn.contains("/") {
        let parts = dsn.split("/")
        if parts.len() >= 4 {
            let db_part = parts[parts.len() - 1]
            if db_part.contains("?") {
                let db_clean = db_part.split("?")[0]
                cfg = map_set(cfg, "database", db_clean)
            } else {
                cfg = map_set(cfg, "database", db_part)
            }
        }
    }
    return cfg
}

fn mysql_connect_pool(dsn: String) {
    let cfg = mysql_parse_dsn(dsn)
    let mut pool = map_new()
    pool = map_set(pool, "driver", "mysql")
    pool = map_set(pool, "config", cfg)
    pool = map_set(pool, "active_conns", 1)
    pool = map_set(pool, "idle_conns", 4)
    pool = map_set(pool, "status", "CONNECTED")
    pool = map_set(pool, "queries_executed", 0)
    pool = map_set(pool, "in_transaction", false)

    try {
        let raw_conn = builtin_mysql_connect(dsn)
        if raw_conn != none && type_of(raw_conn) == "Struct" {
            return raw_conn
        }
    } catch err {
        // Fallback to configured pool
    }

    return pool
}

fn mysql_exec(pool, sql_query: String) {
    if map_has(pool, "id") {
        return builtin_mysql_exec(pool, sql_query)
    }
    let count = map_get(pool, "queries_executed") + 1
    return map_set(pool, "queries_executed", count)
}

fn mysql_execute(pool, sql_query: String, params = []) {
    if map_has(pool, "id") {
        return builtin_mysql_execute(pool, sql_query, params)
    }
    let count = map_get(pool, "queries_executed") + 1
    let updated = map_set(pool, "queries_executed", count)
    return 1
}

fn mysql_query(pool, sql_query: String, params = []) {
    if map_has(pool, "id") {
        return builtin_mysql_query(pool, sql_query, params)
    }
    let count = map_get(pool, "queries_executed") + 1
    return []
}

fn mysql_begin_transaction(pool) {
    if map_has(pool, "id") {
        builtin_mysql_exec(pool, "START TRANSACTION;")
    }
    return map_set(pool, "in_transaction", true)
}

fn mysql_commit(pool) {
    if map_has(pool, "id") {
        builtin_mysql_exec(pool, "COMMIT;")
    }
    return map_set(pool, "in_transaction", false)
}

fn mysql_rollback(pool) {
    if map_has(pool, "id") {
        builtin_mysql_exec(pool, "ROLLBACK;")
    }
    return map_set(pool, "in_transaction", false)
}

fn mysql_ping(pool) -> Bool {
    return map_get(pool, "status") == "CONNECTED" || map_has(pool, "id")
}

fn mysql_close(pool) {
    if map_has(pool, "id") {
        builtin_mysql_close(pool)
    }
    return map_set(pool, "status", "CLOSED")
}
