// ========================================================================
// VietLang MySQL compatibility API (disabled in 0.2.0-alpha.2)
// The previous synchronous native driver has been removed because its dependency
// graph contains a RustSec-unsound cache crate. These calls fail explicitly until
// a reviewed async pool implementation replaces it.
// ========================================================================

fn mysql_parse_dsn(dsn: String) {
    let mut cfg = map_new()
    cfg = map_set(cfg, "raw_dsn", dsn)
    cfg = map_set(cfg, "host", "127.0.0.1")
    cfg = map_set(cfg, "port", 3306)
    cfg = map_set(cfg, "user", "root")
    cfg = map_set(cfg, "database", "")
    cfg = map_set(cfg, "max_open_conns", 50)
    cfg = map_set(cfg, "max_idle_conns", 10)
    cfg = map_set(cfg, "conn_max_lifetime_sec", 300)
    cfg = map_set(cfg, "charset", "utf8mb4")

    if dsn.contains("/") {
        let parts = dsn.split("/")
        if parts.len() >= 4 {
            let db_part = parts[parts.len() - 1]
            if db_part.contains("?") {
                let db_clean = db_part.split("?")[0]
                cfg = map_set(cfg, "database", db_clean)
            } else {
                cfg = map_set(cfg, "database", db_part)
            }
        }
    }
    return cfg
}

fn mysql_connect_pool(dsn: String) {
    return builtin_mysql_connect(dsn)
}

fn mysql_exec(pool, sql_query: String) {
    return builtin_mysql_exec(pool, sql_query)
}

fn mysql_execute(pool, sql_query: String, params = []) {
    return builtin_mysql_execute(pool, sql_query, params)
}

fn mysql_query(pool, sql_query: String, params = []) {
    return builtin_mysql_query(pool, sql_query, params)
}

fn mysql_begin_transaction(pool) {
    return builtin_mysql_exec(pool, "START TRANSACTION;")
}

fn mysql_commit(pool) {
    return builtin_mysql_exec(pool, "COMMIT;")
}

fn mysql_rollback(pool) {
    return builtin_mysql_exec(pool, "ROLLBACK;")
}

fn mysql_ping(pool) -> Bool {
    builtin_mysql_query(pool, "SELECT 1", [])
    return true
}

fn mysql_close(pool) {
    return builtin_mysql_close(pool)
}
