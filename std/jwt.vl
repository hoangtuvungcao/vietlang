// ===================================================
// VietLang JWT Library (std.jwt)
// Pure VietLang JSON Web Token Generator & Verifier
// ===================================================

fn jwt_create_header() {
    let header = map_new()
    let header = map_set(header, "alg", "HS256")
    let header = map_set(header, "typ", "JWT")
    return header
}

fn jwt_sign(payload_map, secret: String) -> String {
    if env_get("VIETLANG_ENABLE_EXPERIMENTAL_JWT", "") != "1" {
        throw("std.jwt is disabled pending complete JWT claim validation and conformance; set VIETLANG_ENABLE_EXPERIMENTAL_JWT=1 only for non-production compatibility testing")
    }
    let header_json = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}"
    let payload_json = json_stringify(payload_map)

    let encoded_header = base64_url_encode(header_json)
    let encoded_payload = base64_url_encode(payload_json)

    let message = encoded_header + "." + encoded_payload
    let signature = hmac_sha256_base64url(message, secret)

    return message + "." + signature
}

fn jwt_verify(token: String, secret: String) {
    if env_get("VIETLANG_ENABLE_EXPERIMENTAL_JWT", "") != "1" {
        throw("std.jwt is disabled pending complete JWT claim validation and conformance")
    }
    let parts = token.split(".")
    if parts.len() != 3 {
        return map_set(map_new(), "valid", false)
    }

    let encoded_header = parts[0]
    let encoded_payload = parts[1]
    let expected_sig = parts[2]

    let message = encoded_header + "." + encoded_payload
    let actual_sig = hmac_sha256_base64url(message, secret)

    if !secure_compare(expected_sig, actual_sig) {
        return map_set(map_new(), "valid", false)
    }

    let result = map_new()
    let result = map_set(result, "valid", true)
    let result = map_set(result, "header_raw", encoded_header)
    let result = map_set(result, "payload_raw", encoded_payload)
    return result
}
