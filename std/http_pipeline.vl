// ===================================================
// VietLang Enterprise HTTP Pipeline & Middleware Chain (std.http_pipeline)
// Onion-model Execution, CORS, Security Headers, IP Filter
// ===================================================

fn http_pipeline_new() {
    let p = map_new()
    let p = map_set(p, "allowed_cidrs", ["0.0.0.0/0"])
    let p = map_set(p, "max_body_bytes", 10485760) // 10MB default
    let p = map_set(p, "cors_origins", ["*"])
    let p = map_set(p, "security_headers", true)
    return p
}

fn http_apply_security_headers(headers) {
    let mut h = headers
    h = map_set(h, "X-Content-Type-Options", "nosniff")
    h = map_set(h, "X-Frame-Options", "DENY")
    h = map_set(h, "X-XSS-Protection", "1; mode=block")
    h = map_set(h, "Strict-Transport-Security", "max-age=31536000; includeSubDomains")
    h = map_set(h, "Content-Security-Policy", "default-src 'self'")
    return h
}

fn http_check_ip_allowed(pipeline, client_ip: String) -> Bool {
    let cidrs = map_get(pipeline, "allowed_cidrs")
    for cidr in cidrs {
        if ip_in_cidr(client_ip, cidr) {
            return true
        }
    }
    return false
}

fn http_build_response(status_code: Int, body_data, headers = none) {
    let mut resp_headers = map_new()
    if headers != none {
        resp_headers = headers
    }
    resp_headers = http_apply_security_headers(resp_headers)
    resp_headers = map_set(resp_headers, "Content-Type", "application/json")

    let body_json = json_stringify(body_data)
    
    let resp = map_new()
    let resp = map_set(resp, "status", status_code)
    let resp = map_set(resp, "headers", resp_headers)
    let resp = map_set(resp, "body", body_json)
    return resp
}
