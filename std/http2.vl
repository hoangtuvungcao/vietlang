// ========================================================================
// HTTP/2 server configuration helpers (std.http2).
// The native http_listen runtime provides HTTP/1.1 + HTTP/2 via Hyper/Axum.
// Use tls_cert_file/tls_key_file directly in a config Map for HTTPS + ALPN.
// ========================================================================

fn http2_server_config(port: Int = 9090, max_concurrent_streams: Int = 250) {
    let mut cfg = map_new()
    cfg = map_set(cfg, "addr", "0.0.0.0:" + to_string(port))
    cfg = map_set(cfg, "port", port)
    cfg = map_set(cfg, "protocol", "HTTP/1.1 + HTTP/2")
    cfg = map_set(cfg, "max_concurrency", max_concurrent_streams)
    cfg = map_set(cfg, "max_body_bytes", 1048576)
    cfg = map_set(cfg, "max_header_bytes", 65536)
    cfg = map_set(cfg, "max_response_bytes", 8388608)
    cfg = map_set(cfg, "request_timeout_ms", 30000)
    return cfg
}

fn http2_create_stream(stream_id: Int, path: String) {
    let mut s = map_new()
    s = map_set(s, "stream_id", stream_id)
    s = map_set(s, "path", path)
    s = map_set(s, "state", "OPEN")
    s = map_set(s, "created_at", time_now())
    return s
}

fn http2_push_promise(stream, resource_path: String, content_type: String) {
    let mut promise = map_new()
    promise = map_set(promise, "parent_stream_id", map_get(stream, "stream_id"))
    promise = map_set(promise, "path", resource_path)
    promise = map_set(promise, "content_type", content_type)
    promise = map_set(promise, "status", "PROMISED")
    return promise
}
