{
  "name": "my_clean_api",
  "version": "1.0.0",
  "author": "developer",
  "repository": "https://github.com/developer/my_clean_api.git",
  "type": "backend_api",
  "description": "Production Backend REST API & High-Performance Microservice in VietLang",
  "main": "src/main.vl",
  "scripts": {
    "start": "vietlang run src/main.vl",
