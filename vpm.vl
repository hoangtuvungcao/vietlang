// ===================================================
// VietLang Package Manager (vpm) v0.3.0
// Decentralized Git & Local Package Management
// Written 100% in pure VietLang
// ===================================================

let args = get_args()

fn show_help() {
    println("VietLang Package Manager (vpm) v0.3.0")
    println("Decentralized & Serverless Community Package Toolchain")
    println("=======================================================")
    println("Usage:")
    println("  vietlang vpm.vl init <name> [api|lib|microservice]  Initialize new project")
    println("  vietlang vpm.vl install <git-url | pkg-name>        Install decentralized Git module")
    println("  vietlang vpm.vl remove <module-name>                Remove an installed module")
    println("  vietlang vpm.vl update <module-name>                Update Git module (git pull)")
    println("  vietlang vpm.vl list                                List installed modules")
    println("  vietlang vpm.vl info                                Show package manifest")
    println("  vietlang vpm.vl publish                             Validate package for release")
    println("  vietlang vpm.vl help                                Show this help message")
    println("")
}

fn vpm_init(pkg_name: String, template_type: String = "api") {
    if pkg_name == "" {
        println("Error: Package name required. Example: vietlang vpm.vl init my_backend api")
        return none
    }

    let manifest = map_new()
    let manifest = map_set(manifest, "name", pkg_name)
    let manifest = map_set(manifest, "version", "0.1.0")
    let manifest = map_set(manifest, "type", template_type)
    let manifest = map_set(manifest, "description", "High-performance backend service built with VietLang")
    let manifest = map_set(manifest, "main", "src/main.vl")
    let manifest = map_set(manifest, "dependencies", map_new())
    let manifest = map_set(manifest, "license", "MIT")

    // Create directories
    dir_create(pkg_name)
    dir_create(pkg_name + "/src")
    dir_create(pkg_name + "/tests")
    dir_create(pkg_name + "/modules")

    // Write manifest
    let manifest_json = json_stringify(manifest, true)
    file_write(pkg_name + "/vietlang.json", manifest_json)

    // Write starter template based on type
    let mut starter_code = ""
    if template_type == "microservice" {
        starter_code = "import std.http_router\nimport std.config\nimport std.rate_limiter\nimport std.jwt\nimport std.socket\n\nprintln(\"Starting " + pkg_name + " enterprise microservice...\")\n"
    } else if template_type == "lib" {
        starter_code = "// " + pkg_name + " Community Library\nfn hello_vietlang() -> String {\n    return \"Hello from " + pkg_name + "!\"\n}\n"
    } else {
        starter_code = "import std.http_router\nimport std.validator\n\nprintln(\"Starting " + pkg_name + " REST API on port 8080...\")\n"
    }
    file_write(pkg_name + "/src/main.vl", starter_code)

    // Write starter test
    let test_code = "import std.test\n\nsuite(\"" + pkg_name + " Unit Tests\")\n\ntest(\"Basic sanity verification\", fn() {\n    assert_eq(1 + 1, 2, \"Arithmetic failure\")\n})\n\ntest_summary()\n"
    file_write(pkg_name + "/tests/main_test.vl", test_code)

    println("Created new VietLang [" + template_type + "] package '" + pkg_name + "' successfully:")
    println("  " + pkg_name + "/vietlang.json")
    println("  " + pkg_name + "/src/main.vl")
    println("  " + pkg_name + "/tests/main_test.vl")
    println("  " + pkg_name + "/modules/")
    println("")
    println("Get started:")
    println("  cd " + pkg_name)
    println("  vietlang src/main.vl")
}

fn vpm_install(source: String) {
    if source == "" {
        println("Error: Module name or Git URL required.")
        println("Examples:")
        println("  vietlang vpm.vl install https://github.com/user/my_module.git")
        println("  vietlang vpm.vl install local_auth_module")
        return none
    }

    if !file_exists("vietlang.json") {
        println("Error: No vietlang.json manifest found in current directory.")
        return none
    }

    dir_create("modules")

    let mut pkg_name = source
    let is_git = source.starts_with("http://") || source.starts_with("https://") || source.starts_with("git@")

    if is_git {
        let mut clean_url = source
        if source.ends_with(".git") {
            clean_url = substring(source, 0, source.len() - 4)
        }
        let parts = clean_url.split("/")
        pkg_name = parts[parts.len() - 1]

        println("Cloning Git repository: " + source + " into modules/" + pkg_name + "...")
        let clone_cmd = "git clone " + source + " modules/" + pkg_name
        let res = system_cmd(clone_cmd)
        if !map_get(res, "success") {
            println("Git clone error: " + to_string(map_get(res, "stderr")))
            return none
        }
    } else {
        dir_create("modules/" + pkg_name)
        dir_create("modules/" + pkg_name + "/src")
        let stub_content = "// Community module: " + pkg_name + "\nfn info() -> String {\n    return \"Module " + pkg_name + "\"\n}\n"
        file_write("modules/" + pkg_name + "/src/main.vl", stub_content)
    }

    // Update vietlang.json
    let raw = file_read("vietlang.json")
    let manifest = json_parse(raw)
    let mut deps = map_new()
    if map_has(manifest, "dependencies") {
        deps = map_get(manifest, "dependencies")
    }

    let new_deps = map_set(deps, pkg_name, source)
    let updated_manifest = map_set(manifest, "dependencies", new_deps)
    file_write("vietlang.json", json_stringify(updated_manifest, true))

    println("Successfully installed module '" + pkg_name + "'")
    println("Usage in your code:")
    println("  import modules." + pkg_name + ".src.main")
}

fn vpm_remove(mod_name: String) {
    if mod_name == "" {
        println("Error: Module name required.")
        return none
    }

    if !file_exists("vietlang.json") {
        println("Error: No vietlang.json manifest found.")
        return none
    }

    let rm_cmd = "rm -rf modules/" + mod_name
    system_cmd(rm_cmd)

    let raw = file_read("vietlang.json")
    let manifest = json_parse(raw)
    if map_has(manifest, "dependencies") {
        let deps = map_get(manifest, "dependencies")
        let new_deps = map_remove(deps, mod_name)
        let updated_manifest = map_set(manifest, "dependencies", new_deps)
        file_write("vietlang.json", json_stringify(updated_manifest, true))
    }

    println("Removed module '" + mod_name + "' successfully.")
}

fn vpm_update(mod_name: String) {
    if mod_name == "" {
        println("Error: Module name required.")
        return none
    }

    let target_dir = "modules/" + mod_name
    if !file_exists(target_dir + "/.git") {
        println("Module '" + mod_name + "' is not a Git repository.")
        return none
    }

    let pull_cmd = "cd " + target_dir + " && git pull"
    let res = system_cmd(pull_cmd)
    println("Updated module '" + mod_name + "':\n" + to_string(map_get(res, "stdout")))
}

fn vpm_list() {
    if !file_exists("modules") {
        println("No modules/ directory found.")
        return none
    }
    let installed = dir_list("modules")
    println("Installed community modules in modules/:")
    for mod_name in installed {
        println("  * " + mod_name)
    }
}

fn vpm_publish() {
    if !file_exists("vietlang.json") {
        println("Error: No vietlang.json manifest found.")
        return none
    }
    let raw = file_read("vietlang.json")
    let manifest = json_parse(raw)
    let pkg_name = map_get(manifest, "name")
    let version = map_get(manifest, "version")

    if !file_exists("src/main.vl") {
        println("Error: Main entry point src/main.vl not found.")
        return none
    }

    let src_content = file_read("src/main.vl")
    let checksum = sha256(src_content)

    println("Package Release Validation:")
    println("  Package: " + to_string(pkg_name) + " v" + to_string(version))
    println("  SHA256:  " + checksum)
    println("  To share with the community:")
    println("    1. Push your code to GitHub/GitLab: git push origin main")
    println("    2. Anyone can install directly via: vietlang vpm.vl install <your-git-url>")
}

fn vpm_info() {
    if !file_exists("vietlang.json") {
        println("Error: No vietlang.json manifest found.")
        return none
    }
    let content = file_read("vietlang.json")
    println("Package Manifest (vietlang.json):")
    println(content)
}

// CLI Dispatcher
if args.len() < 3 {
    show_help()
} else {
    let command = args[2]
    if command == "init" {
        let mut pkg_name = "my_project"
        let mut template_type = "api"
        if args.len() >= 4 {
            pkg_name = args[3]
        }
        if args.len() >= 5 {
            template_type = args[4]
        }
        vpm_init(pkg_name, template_type)
    } else if command == "install" {
        let mut source = ""
        if args.len() >= 4 {
            source = args[3]
        }
        vpm_install(source)
    } else if command == "remove" {
        let mut mod_name = ""
        if args.len() >= 4 {
            mod_name = args[3]
        }
        vpm_remove(mod_name)
    } else if command == "update" {
        let mut mod_name = ""
        if args.len() >= 4 {
            mod_name = args[3]
        }
        vpm_update(mod_name)
    } else if command == "list" {
        vpm_list()
    } else if command == "publish" {
        vpm_publish()
    } else if command == "info" {
        vpm_info()
    } else if command == "help" {
        show_help()
    } else {
        println("Unknown command: '" + command + "'")
        show_help()
    }
}
