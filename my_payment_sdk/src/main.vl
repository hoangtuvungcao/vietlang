// ========================================================================
// Module: my_payment_sdk
// VietLang Community Payment Gateway & Banking SDK
// ========================================================================

import std.security

/// Khoi tao payment client ket noi toi cong thanh toan
/// @param api_key: String - Khoa bi mat API
/// @param merchant_id: String - Ma dinh danh doi tac
/// @return Map - Client session map
fn payment_client_new(api_key: String, merchant_id: String) {
    let mut client = map_new()
    client = map_set(client, "api_key", api_key)
    client = map_set(client, "merchant_id", merchant_id)
    client = map_set(client, "version", "1.0.0")
    return client
}

/// Tao chu ky so HMAC SHA256 cho giao dich thanh toan
/// @param client: Map - Payment client
/// @param order_id: String - Ma don hang
/// @param amount: Int - So tien thanh toan
/// @return String - Chu ky bao mat
fn payment_create_signature(client, order_id: String, amount: Int) -> String {
    let key = to_string(map_get(client, "api_key"))
    let raw = order_id + "|" + to_string(amount)
    return security_hmac_sha256(raw, key)
}

/// Tao ma QR chuyen khoan nhanh (VietQR Format)
/// @param bank_code: String - Ma ngan hang (e.g. VCB, TCB, MB)
/// @param account_no: String - So tai khoan
/// @param amount: Int - So tien
/// @param memo: String - Noi dung chuyen khoan
/// @return String - Link anh VietQR
fn payment_generate_vietqr_url(bank_code: String, account_no: String, amount: Int, memo: String) -> String {
    let url = "https://img.vietqr.io/image/" + bank_code + "-" + account_no + "-compact2.png?amount=" + to_string(amount) + "&addInfo=" + memo
    return url
}
