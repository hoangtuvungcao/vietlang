import std.test
import my_payment_sdk.src.main

suite("my_payment_sdk Community Library Test Suite")

test("Payment Client Initialization & Signature", fn() {
    let client = payment_client_new("secret_key_123", "MERCHANT_99")
    assert_eq(map_get(client, "merchant_id"), "MERCHANT_99", "Merchant ID phai khop")

    let sig = payment_create_signature(client, "DH_101", 500000)
    assert_true(sig.len() > 10, "Chu ky HMAC SHA256 phai hop le")
})

test("VietQR URL Generator", fn() {
    let qr = payment_generate_vietqr_url("VCB", "0123456789", 250000, "DH101")
    assert_true(qr.contains("img.vietqr.io"), "VietQR URL phai dung host")
    assert_true(qr.contains("VCB"), "VietQR URL phai chua ma ngan hang")
})

test_summary()
