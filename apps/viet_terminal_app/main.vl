// ========================================================================
// VietFintech Terminal Pro — Interactive Console Desktop Application
// Built 100% natively in VietLang (Zero Web, Zero Browser, Pure TUI App)
// ========================================================================

import std.db_sqlite
import std.vietqr
import std.concurrency
import std.json

// ANSI Color Tokens
let C_RESET = "\x1b[0m"
let C_BOLD = "\x1b[1m"
let C_CYAN = "\x1b[36m"
let C_GREEN = "\x1b[32m"
let C_YELLOW = "\x1b[33m"
let C_BLUE = "\x1b[34m"
let C_MAGENTA = "\x1b[35m"
let C_RED = "\x1b[31m"
let C_DIM = "\x1b[90m"

fn clear_screen() {
    print("\x1b[2J\x1b[H")
}

fn print_banner() {
    println(C_CYAN + C_BOLD + "╔════════════════════════════════════════════════════════════════════════════╗" + C_RESET)
    println(C_CYAN + C_BOLD + "║   __      ___      _   _____ _       _            _     _____              ║" + C_RESET)
    println(C_CYAN + C_BOLD + "║   \\ \\    / (_)    | | |  ___(_)_ __ | |_ ___  ___| |__ |_   _|           ║" + C_RESET)
    println(C_CYAN + C_BOLD + "║    \\ \\  / /| | ___| |_| |_  | | '_ \\| __/ _ \\/ __| '_ \\  | |          ║" + C_RESET)
    println(C_CYAN + C_BOLD + "║     \\ \\/ / | |/ _ \\ __|  _| | | | | | ||  __/ (__| | | | | |            ║" + C_RESET)
    println(C_CYAN + C_BOLD + "║      \\  /  | |  __/ |_|_|   |_|_| |_|\\__\\___|\\___|_| |_| |_|           ║" + C_RESET)
    println(C_CYAN + C_BOLD + "║       \\/   |_|\\___|\\__|     Terminal Desktop Application v1.0.0          ║" + C_RESET)
    println(C_CYAN + C_BOLD + "╚════════════════════════════════════════════════════════════════════════════╝" + C_RESET)
    println(C_GREEN + "  ● Trạng thái: Sẵn sàng  |  ● CSDL: SQLite ACID  |  ● Động cơ: VietLang Native" + C_RESET)
    println(C_DIM + "------------------------------------------------------------------------------" + C_RESET)
}

// ------------------------------------------------------------------------
// Database Initialization
// ------------------------------------------------------------------------
fn init_app_database() {
    let db_path = "apps/viet_terminal_app/data/app.sqlite"
    let db = sqlite_open(db_path)
    sqlite_exec(db, "CREATE TABLE IF NOT EXISTS transactions (id INTEGER PRIMARY KEY AUTOINCREMENT, order_id TEXT, bank_code TEXT, account_no TEXT, amount INTEGER, note TEXT, created_at INTEGER)")
    return db
}

// ------------------------------------------------------------------------
// Feature 1: VietQR Payment Terminal
// ------------------------------------------------------------------------
fn run_vietqr_terminal(db) {
    clear_screen()
    println(C_MAGENTA + C_BOLD + "=== [1] MÁY TẠO & XÁC THỰC MÃ THANH TOÁN VIETQR (NAPAS 247) ===" + C_RESET)
    println()

    println("Danh sách ngân hàng hỗ trợ: " + C_YELLOW + "MB (Quân Đội), VCB (Vietcombank), TCB (Techcombank), VPB (VPBank), ACB, BIDV, CTG (VietinBank), TPB, TIMO" + C_RESET)
    println()

    let bank = input(C_BOLD + "-> Nhập mã ngân hàng [Mặc định: MB]: " + C_RESET)
    let mut bank_code = "MB"
    if trim(bank) != "" {
        bank_code = to_uppercase(trim(bank))
    }

    let acc = input(C_BOLD + "-> Nhập số tài khoản thụ hưởng [Mặc định: 0901234567]: " + C_RESET)
    let mut account_no = "0901234567"
    if trim(acc) != "" {
        account_no = trim(acc)
    }

    let amt_str = input(C_BOLD + "-> Nhập số tiền giao dịch (VNĐ) [Mặc định: 250000]: " + C_RESET)
    let mut amount = 250000
    if trim(amt_str) != "" {
        amount = to_int(trim(amt_str))
    }

    let note_str = input(C_BOLD + "-> Nhập nội dung chuyển khoản [Mặc định: Thanh toan don hang]: " + C_RESET)
    let mut note = "Thanh toan don hang"
    if trim(note_str) != "" {
        note = trim(note_str)
    }

    let bin = vietqr_get_bank_bin(bank_code)
    let qr_res = vietqr_create_payment(bank_code, account_no, amount, note)
    let qr_url = to_string(map_get(qr_res, "qr_url"))
    let order_id = "ORD_" + to_string(time_now())

    // Save to SQLite
    let query = "INSERT INTO transactions (order_id, bank_code, account_no, amount, note, created_at) VALUES ('" + order_id + "', '" + bank_code + "', '" + account_no + "', " + to_string(amount) + ", '" + note + "', " + to_string(time_now()) + ")"
    sqlite_exec(db, query)

    println()
    println(C_GREEN + C_BOLD + "╔════════════════════════════════════════════════════════════════════════════╗" + C_RESET)
    println(C_GREEN + C_BOLD + "║                      HÓA ĐƠN THANH TOÁN VIETQR                             ║" + C_RESET)
    println(C_GREEN + C_BOLD + "╠════════════════════════════════════════════════════════════════════════════╣" + C_RESET)
    println("║  Mã Đơn Hàng:      " + C_YELLOW + order_id + C_RESET)
    println("║  Ngân Hàng:        " + C_CYAN + bank_code + " (Mã BIN Napas: " + bin + ")" + C_RESET)
    println("║  Số Tài Khoản:     " + C_BOLD + account_no + C_RESET)
    println("║  Số Tiền:          " + C_GREEN + C_BOLD + to_string(amount) + " VNĐ" + C_RESET)
    println("║  Nội Dung:         " + note)
    println("║  Trạng Thái:       " + C_GREEN + "● Đã lưu vào CSDL SQLite thành công" + C_RESET)
    println("║  Đường Dẫn QR:     " + C_CYAN + qr_url + C_RESET)
    println(C_GREEN + C_BOLD + "╚════════════════════════════════════════════════════════════════════════════╝" + C_RESET)
    println()
    input(C_DIM + "Bấm phím ENTER để quay lại Menu chính..." + C_RESET)
}

// ------------------------------------------------------------------------
// Feature 2: Concurrency Multi-Threading Benchmark
// ------------------------------------------------------------------------
fn run_concurrency_benchmark() {
    clear_screen()
    println(C_YELLOW + C_BOLD + "=== [2] BỘ ĐO HIỆU NĂNG ĐA LUỒNG CSP GOROUTINES & CHANNELS ===" + C_RESET)
    println()
    println("Hệ thống sẽ khởi tạo " + C_CYAN + "500 tác vụ song song" + C_RESET + " trên các Green Thread Workers độc lập.")
    println()
    input(C_BOLD + "Nhấn ENTER để bắt đầu chạy Benchmark đa luồng..." + C_RESET)
    println()

    let t_start = time_now_us()
    let mut items = []
    let mut i = 1
    while i <= 100 {
        items = push(items, i)
        i += 1
    }

    println(C_CYAN + "[1/2] Đang phân bổ 100 tác vụ tính toán vào Worker Pool..." + C_RESET)
    let results = parallel_map(items, fn(x) {
        // Computational work
        let mut sum = 0
        let mut k = 0
        while k < 1000 {
            sum += (x * k) % 997
            k += 1
        }
        return sum
    })

    let t_end = time_now_us()
    let elapsed_us = t_end - t_start
    let elapsed_ms = elapsed_us / 1000

    println(C_GREEN + C_BOLD + "[2/2] HOÀN TẤT 100% CÁC TÁC VỤ ĐỒNG THỜI!" + C_RESET)
    println()
    println(C_BOLD + "📊 KẾT QUẢ ĐO HIỆU NĂNG:" + C_RESET)
    println("  - Số tác vụ xử lý:     " + C_YELLOW + to_string(len(results)) + " tác vụ" + C_RESET)
    println("  - Tổng thời gian:      " + C_GREEN + to_string(elapsed_ms) + " ms (" + to_string(elapsed_us) + " microseconds)" + C_RESET)
    println("  - Tốc độ xử lý:        " + C_CYAN + C_BOLD + to_string((100 * 1000000) / (elapsed_us + 1)) + " Tasks / giây" + C_RESET)
    println("  - Cơ chế:              " + C_MAGENTA + "Rust OS Threads + Safe Mutex Condvar Queues" + C_RESET)
    println()
    input(C_DIM + "Bấm phím ENTER để quay lại Menu chính..." + C_RESET)
}

// ------------------------------------------------------------------------
// Feature 3: SQLite Ledger Manager
// ------------------------------------------------------------------------
fn run_ledger_manager(db) {
    clear_screen()
    println(C_BLUE + C_BOLD + "=== [3] SỔ CÁI GIAO DỊCH LƯU TRỮ TRÊN SQLITE ACID ===" + C_RESET)
    println()

    let rows = sqlite_query(db, "SELECT id, order_id, bank_code, account_no, amount, note, created_at FROM transactions ORDER BY id DESC LIMIT 20")
    let count = len(rows)

    if count == 0 {
        println(C_YELLOW + "Hiện chưa có giao dịch nào được ghi nhận trong CSDL." + C_RESET)
        println("Hãy sử dụng tính năng [1] để tạo giao dịch VietQR đầu tiên!")
    } else {
        println(C_BOLD + "Danh sách " + to_string(count) + " giao dịch gần nhất trong file SQLite:" + C_RESET)
        println()
        println(C_DIM + "┌─────┬─────────────────────┬──────────┬──────────────┬──────────────┬──────────────────────────────┐" + C_RESET)
        println(C_BOLD + "│ ID  │ Mã Đơn Hàng         │ Ngân Hàng│ Số Tài Khoản │ Số Tiền      │ Nội Dung Chuyển Khoản        │" + C_RESET)
        println(C_DIM + "├─────┼─────────────────────┼──────────┼──────────────┼──────────────┼──────────────────────────────┤" + C_RESET)

        for row in rows {
            let id_str = to_string(map_get(row, "id"))
            let ord = to_string(map_get(row, "order_id"))
            let bnk = to_string(map_get(row, "bank_code"))
            let acc = to_string(map_get(row, "account_no"))
            let amt = to_string(map_get(row, "amount")) + " d"
            let nte = to_string(map_get(row, "note"))
            println("│ " + id_str + "   │ " + ord + "   │ " + bnk + "      │ " + acc + "   │ " + amt + "      │ " + nte)
        }
        println(C_DIM + "└─────┴─────────────────────┴──────────┴──────────────┴──────────────┴──────────────────────────────┘" + C_RESET)
    }

    println()
    input(C_DIM + "Bấm phím ENTER để quay lại Menu chính..." + C_RESET)
}

// ------------------------------------------------------------------------
// Feature 4: Cryptography & Security Terminal
// ------------------------------------------------------------------------
fn run_crypto_terminal() {
    clear_screen()
    println(C_RED + C_BOLD + "=== [4] CÔNG CỤ MÃ HÓA & CHỮ KÝ SỐ (HMAC & SHA-512) ===" + C_RESET)
    println()

    let msg = input(C_BOLD + "-> Nhập chuỗi văn bản cần ký số: " + C_RESET)
    let mut message = "VIETLANG_ENTERPRISE_TRANSACTION"
    if trim(msg) != "" { message = trim(msg) }

    let key_in = input(C_BOLD + "-> Nhập khóa bí mật (Secret Key) [Mặc định: secret_key_2026]: " + C_RESET)
    let mut key = "secret_key_2026"
    if trim(key_in) != "" { key = trim(key_in) }

    let sha256_hash = sha256(message)
    let hmac256 = hmac_sha256(message, key)
    let hmac512 = hmac_sha512(message, key)
    let encrypted = encrypt_secret(message, key)

    println()
    println(C_CYAN + C_BOLD + "Kết quả băm và mã hóa bảo mật:" + C_RESET)
    println("  ● SHA-256 Digest:   " + C_YELLOW + sha256_hash + C_RESET)
    println("  ● HMAC-SHA256:      " + C_GREEN + hmac256 + C_RESET)
    println("  ● HMAC-SHA512:      " + C_CYAN + hmac512 + C_RESET)
    println("  ● AES XOR Cipher:   " + C_MAGENTA + encrypted + C_RESET)
    println()
    input(C_DIM + "Bấm phím ENTER để quay lại Menu chính..." + C_RESET)
}

// ------------------------------------------------------------------------
// Feature 5: Compound Interest Financial Calculator
// ------------------------------------------------------------------------
fn run_interest_calculator() {
    clear_screen()
    println(C_GREEN + C_BOLD + "=== [5] MÁY TÍNH LÃI SUẤT KÉP & ĐẦU TƯ TÍCH LŨY ===" + C_RESET)
    println()

    let p_str = input(C_BOLD + "-> Nhập số vốn ban đầu (VNĐ) [Mặc định: 100000000]: " + C_RESET)
    let mut principal = 100000000
    if trim(p_str) != "" { principal = to_int(trim(p_str)) }

    let r_str = input(C_BOLD + "-> Nhập lãi suất năm (%) [Mặc định: 8.5]: " + C_RESET)
    let mut rate = 0.085
    if trim(r_str) != "" { rate = to_float(trim(r_str)) / 100.0 }

    let y_str = input(C_BOLD + "-> Nhập số năm đầu tư [Mặc định: 5]: " + C_RESET)
    let mut years = 5
    if trim(y_str) != "" { years = to_int(trim(y_str)) }

    println()
    println(C_BOLD + "BẢNG TIẾN TRÌNH TĂNG TRƯỞNG TÀI SẢN QUA CÁC NĂM:" + C_RESET)
    println(C_DIM + "┌──────┬──────────────────────┬──────────────────────┬──────────────────────┐" + C_RESET)
    println(C_BOLD + "│ Năm  │ Vốn Đầu Năm          │ Tiền Lãi Trong Năm   │ Tổng Số Dư Cuối Năm  │" + C_RESET)
    println(C_DIM + "├──────┼──────────────────────┼──────────────────────┼──────────────────────┤" + C_RESET)

    let mut current_balance = principal
    let mut yr = 1
    while yr <= years {
        let interest = to_int(current_balance * rate)
        let end_balance = current_balance + interest
        println("│  " + to_string(yr) + "   │ " + to_string(current_balance) + " VNĐ        │ +" + to_string(interest) + " VNĐ        │ " + C_GREEN + to_string(end_balance) + " VNĐ" + C_RESET + "        │")
        current_balance = end_balance
        yr += 1
    }
    println(C_DIM + "└──────┴──────────────────────┴──────────────────────┴──────────────────────┘" + C_RESET)
    let total_profit = current_balance - principal
    println()
    println("Tổng lợi nhuận sau " + to_string(years) + " năm: " + C_GREEN + C_BOLD + "+" + to_string(total_profit) + " VNĐ (" + to_string(to_int((total_profit * 100) / principal)) + "%)" + C_RESET)
    println()
    input(C_DIM + "Bấm phím ENTER để quay lại Menu chính..." + C_RESET)
}

// ------------------------------------------------------------------------
// Main Terminal Loop
// ------------------------------------------------------------------------
fn main() {
    let db = init_app_database()

    let mut running = true
    while running {
        clear_screen()
        print_banner()

        println(C_BOLD + "DANH MỤC TÍNH NĂNG ỨNG DỤNG:" + C_RESET)
        println("  [" + C_CYAN + "1" + C_RESET + "] 💳 Sinh & Xác Thực Mã Thanh Toán VietQR (Napas 247)")
        println("  [" + C_YELLOW + "2" + C_RESET + "] ⚡ Đo Hiệu Năng Đa Luồng CSP Goroutines & Channel Benchmark")
        println("  [" + C_BLUE + "3" + C_RESET + "] 📊 Quản Lý Sổ Cái Giao Dịch CSDL SQLite ACID")
        println("  [" + C_RED + "4" + C_RESET + "] 🔐 Công Cụ Mã Hóa & Ký Số (HMAC-SHA256, HMAC-SHA512)")
        println("  [" + C_GREEN + "5" + C_RESET + "] 📈 Máy Tính Lãi Suất Kép & Đầu Tư Tích Lũy")
        println("  [" + C_MAGENTA + "0" + C_RESET + "] 🚪 Thoát Ứng Dụng (Exit)")
        println()

        let choice = input(C_BOLD + C_CYAN + "👉 Nhập lựa chọn của bạn [0-5]: " + C_RESET)
        let c = trim(choice)

        if c == "1" {
            run_vietqr_terminal(db)
        } else if c == "2" {
            run_concurrency_benchmark()
        } else if c == "3" {
            run_ledger_manager(db)
        } else if c == "4" {
            run_crypto_terminal()
        } else if c == "5" {
            run_interest_calculator()
        } else if c == "0" || c == "q" || c == "exit" {
            running = false
            clear_screen()
            println(C_GREEN + C_BOLD + "Cảm ơn bạn đã sử dụng VietFintech Terminal Pro! Hẹn gặp lại." + C_RESET)
        }
    }
}

main()
