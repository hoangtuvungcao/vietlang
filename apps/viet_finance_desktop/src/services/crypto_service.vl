// ========================================================================
// Module: crypto_service.vl
// Cryptography, HMAC signatures & hash digests
// ========================================================================

pub fn compute_security_bundle(message: String, key: String) {
    let sha256_hash = sha256(message)
    let hmac256 = hmac_sha256(message, key)
    let hmac512 = hmac_sha512(message, key)
    let encrypted = encrypt_secret(message, key)

    let mut bundle = map_new()
    bundle = map_set(bundle, "sha256", sha256_hash)
    bundle = map_set(bundle, "hmac256", hmac256)
    bundle = map_set(bundle, "hmac512", hmac512)
    bundle = map_set(bundle, "encrypted", encrypted)
    return bundle
}
