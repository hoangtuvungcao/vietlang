// ========================================================================
// Module: benchmark_service.vl
// Multi-threaded CSP Goroutines & Workers performance measurement
// ========================================================================

import std.concurrency

pub fn execute_parallel_benchmark(task_count: Int) {
    let mut items = []
    let mut i = 1
    while i <= task_count {
        items = push(items, i)
        i += 1
    }

    let t_start = time_now_ms()
    let results = parallel_map(items, fn(x) {
        let mut sum = 0
        let mut k = 0
        while k < 500 {
            sum += (x * k) % 997
            k += 1
        }
        return sum
    })
    let t_end = time_now_ms()
    let elapsed_ms = t_end - t_start
    if elapsed_ms == 0 {
        elapsed_ms = 1
    }

    let mut report = map_new()
    report = map_set(report, "task_count", task_count)
    report = map_set(report, "elapsed_ms", elapsed_ms)
    report = map_set(report, "throughput_tps", (task_count * 1000) / elapsed_ms)
    return report
}
