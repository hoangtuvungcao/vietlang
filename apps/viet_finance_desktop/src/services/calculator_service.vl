// ========================================================================
// Module: calculator_service.vl
// Compound interest math calculations
// ========================================================================

pub fn calculate_compound_growth(principal: Int, rate: Float, years: Int) {
    let mut schedule = []
    let mut current_balance = principal
    let mut yr = 1

    while yr <= years {
        let interest = to_int(current_balance * rate)
        let end_balance = current_balance + interest

        let mut row = map_new()
        row = map_set(row, "year", yr)
        row = map_set(row, "start_balance", current_balance)
        row = map_set(row, "interest", interest)
        row = map_set(row, "end_balance", end_balance)
        schedule = push(schedule, row)

        current_balance = end_balance
        yr += 1
    }

    let mut result = map_new()
    result = map_set(result, "schedule", schedule)
    result = map_set(result, "final_balance", current_balance)
    result = map_set(result, "total_profit", current_balance - principal)
    return result
}
