// ========================================================================
// Module: theme.vl
// Terminal & GUI Styling Tokens
// ========================================================================

pub let C_RESET = "\x1b[0m"
pub let C_BOLD = "\x1b[1m"
pub let C_CYAN = "\x1b[36m"
pub let C_GREEN = "\x1b[32m"
pub let C_YELLOW = "\x1b[33m"
pub let C_BLUE = "\x1b[34m"
pub let C_MAGENTA = "\x1b[35m"
pub let C_RED = "\x1b[31m"
pub let C_DIM = "\x1b[90m"

pub fn clear_screen() {
    print("\x1b[2J\x1b[H")
}
