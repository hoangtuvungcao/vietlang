// ========================================================================
// Module: qr_view.vl
// VietQR Payment Receipt Box View
// ========================================================================

import apps.viet_finance_desktop.src.config.theme

pub fn render_qr_receipt(tx_data) {
    let order_id = to_string(map_get(tx_data, "order_id"))
    let bank_code = to_string(map_get(tx_data, "bank_code"))
    let bin = to_string(map_get(tx_data, "bin"))
    let account_no = to_string(map_get(tx_data, "account_no"))
    let amount = to_string(map_get(tx_data, "amount"))
    let note = to_string(map_get(tx_data, "note"))
    let qr_url = to_string(map_get(tx_data, "qr_url"))

    println()
    println(C_GREEN + C_BOLD + "╔════════════════════════════════════════════════════════════════════════════╗" + C_RESET)
    println(C_GREEN + C_BOLD + "║                      HÓA ĐƠN THANH TOÁN VIETQR                             ║" + C_RESET)
    println(C_GREEN + C_BOLD + "╠════════════════════════════════════════════════════════════════════════════╣" + C_RESET)
    println("║  Mã Đơn Hàng:      " + C_YELLOW + order_id + C_RESET)
    println("║  Ngân Hàng:        " + C_CYAN + bank_code + " (Mã BIN Napas: " + bin + ")" + C_RESET)
    println("║  Số Tài Khoản:     " + C_BOLD + account_no + C_RESET)
    println("║  Số Tiền:          " + C_GREEN + C_BOLD + amount + " VNĐ" + C_RESET)
    println("║  Nội Dung:         " + note)
    println("║  Trạng Thái:       " + C_GREEN + "● Đã lưu vào CSDL SQLite thành công" + C_RESET)
    println("║  Đường Dẫn QR:     " + C_CYAN + qr_url + C_RESET)
    println(C_GREEN + C_BOLD + "╚════════════════════════════════════════════════════════════════════════════╝" + C_RESET)
    println()
}
