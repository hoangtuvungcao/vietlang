import apps.viet_finance_desktop.src.config.theme

pub fn render_app_banner() {
    println(C_CYAN + C_BOLD + "╔════════════════════════════════════════════════════════════════════════════╗" + C_RESET)
    println(C_CYAN + C_BOLD + "║   __      ___      _   _____ _       _            _     _____              ║" + C_RESET)
    println(C_CYAN + C_BOLD + "║   \\ \\    / (_)    | | |  ___(_)_ __ | |_ ___  ___| |__ |_   _|           ║" + C_RESET)
    println(C_CYAN + C_BOLD + "║    \\ \\  / /| | ___| |_| |_  | | '_ \\| __/ _ \\/ __| '_ \\  | |          ║" + C_RESET)
    println(C_CYAN + C_BOLD + "║     \\ \\/ / | |/ _ \\ __|  _| | | | | | ||  __/ (__| | | | | |            ║" + C_RESET)
    println(C_CYAN + C_BOLD + "║      \\  /  | |  __/ |_|_|   |_|_| |_|\\__\\___|\\___|_| |_| |_|           ║" + C_RESET)
    println(C_CYAN + C_BOLD + "║       \\/   |_|\\___|\\__|     Desktop Finance Terminal Application        ║" + C_RESET)
    println(C_CYAN + C_BOLD + "╚════════════════════════════════════════════════════════════════════════════╝" + C_RESET)
    println(C_GREEN + "  ● Trạng thái: Online  |  ● CSDL: SQLite ACID  |  ● Động cơ: VietLang Native" + C_RESET)
    println(C_DIM + "------------------------------------------------------------------------------" + C_RESET)
}
