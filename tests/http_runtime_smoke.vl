let mut config = map_new()
config = map_set(config, "addr", "127.0.0.1")
config = map_set(config, "port", 18080)
config = map_set(config, "workers", 2)
config = map_set(config, "max_concurrency", 8)
config = map_set(config, "max_body_bytes", 1024)
config = map_set(config, "max_header_bytes", 4096)
config = map_set(config, "max_response_bytes", 4096)
config = map_set(config, "request_timeout_ms", 2000)

http_listen(config, fn(req) {
    let mut payload = map_new()
    payload = map_set(payload, "method", to_string(map_get(req, "method")))
    payload = map_set(payload, "path", to_string(map_get(req, "path")))
    payload = map_set(payload, "protocol", to_string(map_get(req, "protocol")))

    let mut response = map_new()
    response = map_set(response, "status_code", 200)
    response = map_set(response, "content_type", "application/json; charset=utf-8")
    response = map_set(response, "body", json_stringify(payload, false))
    return response
})
