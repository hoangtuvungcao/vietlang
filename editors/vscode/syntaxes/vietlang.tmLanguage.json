{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "VietLang",
  "scopeName": "source.vietlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#storage_types" },
    { "include": "#constants" },
    { "include": "#function_defs" },
    { "include": "#function_calls" },
    { "include": "#operators" },
    { "include": "#delimiters" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vietlang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.vietlang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vietlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vietlang",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[nrt\\\\\"0])"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.vietlang",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d[\\d_]*)?\\b"
        },
        {
          "name": "constant.numeric.integer.vietlang",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vietlang",
          "match": "\\b(if|else|match|for|while|in|return|break|continue|try|catch)\\b"
        },
        {
          "name": "keyword.other.vietlang",
          "match": "\\b(let|mut|fn|struct|enum|impl|trait|pub|import|type)\\b"
        }
      ]
    },
    "storage_types": {
      "patterns": [
        {
          "name": "entity.name.type.vietlang",
          "match": "\\b(Int|Float|String|Bool|None|Array|Map|Result|Option|Response|Request)\\b"
        },
        {
          "name": "entity.name.type.user-defined.vietlang",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.vietlang",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.vietlang",
          "match": "\\b(none)\\b"
        },
        {
          "name": "variable.language.self.vietlang",
          "match": "\\b(self)\\b"
        }
      ]
    },
    "function_defs": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.other.vietlang" },
            "2": { "name": "entity.name.function.vietlang" }
          }
        }
      ]
    },
    "function_calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.vietlang" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.vietlang",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.comparison.vietlang",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.vietlang",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.vietlang",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.arrow.vietlang",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.range.vietlang",
          "match": "(\\.\\.)"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.vietlang",
          "match": "(,|:|::|;|\\.)"
        },
        {
          "name": "punctuation.bracket.vietlang",
          "match": "([\\(\\)\\[\\]\\{\\}])"
        }
      ]
    }
  }
}
