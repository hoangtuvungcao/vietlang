{
  "name": "vietlang",
  "displayName": "VietLang - Backend Programming Language",
  "description": "Official Visual Studio Code extension for VietLang: Syntax Highlighting, Custom File Icons (.vl), Code Snippets, Bracket Matching, and Language Support.",
  "version": "0.1.1",
  "publisher": "hoangtuvungcao",
  "engines": {
    "vscode": "^1.75.0"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#064E3B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoangtuvungcao/vietlang.git"
  },
  "homepage": "https://github.com/hoangtuvungcao/vietlang",
  "bugs": {
    "url": "https://github.com/hoangtuvungcao/vietlang/issues"
  },
  "keywords": [
    "vietlang",
    "backend",
    "programming language",
    "microservices",
    "database",
    "rest-api",
    "websocket",
    "icon-theme"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vietlang",
        "aliases": [
          "VietLang",
          "vietlang"
        ],
        "extensions": [
          ".vl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/vl-file.svg",
          "dark": "./icons/vl-file.svg"
        }
      }
    ],
    "iconThemes": [
      {
        "id": "vietlang-icons",
        "label": "VietLang File Icons",
        "path": "./icons/icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "vietlang",
        "scopeName": "source.vietlang",
        "path": "./syntaxes/vietlang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "vietlang",
        "path": "./snippets/vietlang.json"
      }
    ]
  }
}
