// ===================================
// VietLang — JSON Processing Demo
// ===================================

println(" VietLang JSON Demo")
println("======================\n")

// --- Create JSON from data ---
println("--- Creating JSON ---\n")

let user = map_new()
let user = map_set(user, "name", "Van Trong")
let user = map_set(user, "age", 25)
let user = map_set(user, "email", "trong@example.com")
let user = map_set(user, "active", true)
let user = map_set(user, "skills", ["Rust", "Go", "VietLang"])

let json_output = json_stringify(user, true)
println("User JSON (pretty):")
println(json_output)

let json_compact = json_stringify(user, false)
println("\nCompact: " + json_compact)

// Pretty print
let pretty = json_stringify(user, true)
println("\nPretty printed JSON:")
println(pretty)

// Parse JSON back
let parsed = json_parse(pretty)
println("\nParsed back name: " + map_get(parsed, "name"))
println("Parsed back email: " + map_get(parsed, "email"))

// Complex nested structure
let config = map_new()
let config = map_set(config, "app_name", "VietLang Server")
let config = map_set(config, "port", 8080)
let config = map_set(config, "debug", false)

let db = map_new()
let db = map_set(db, "host", "localhost")
let db = map_set(db, "port", 5432)
let db = map_set(db, "database", "production_db")
let db = map_set(db, "pool_size", 20)

let config = map_set(config, "database", db)

let roles = ["admin", "moderator", "user"]
let config = map_set(config, "roles", roles)

let features = map_new()
let features = map_set(features, "auth_v2", true)
let features = map_set(features, "rate_limit", true)
let features = map_set(features, "websockets", false)

let config = map_set(config, "features", features)

println("\n--- Complex Configuration ---")
println(json_stringify(config, true))

// JSON with arrays of objects
let users = []
let u1 = map_new()
let u1 = map_set(u1, "id", 1)
let u1 = map_set(u1, "name", "Trong")
let u1 = map_set(u1, "role", "admin")

let u2 = map_new()
let u2 = map_set(u2, "id", 2)
let u2 = map_set(u2, "name", "Minh")
let u2 = map_set(u2, "role", "user")

let u3 = map_new()
let u3 = map_set(u3, "id", 3)
let u3 = map_set(u3, "name", "Lan")
let u3 = map_set(u3, "role", "user")

let users = push(users, u1)
let users = push(users, u2)
let users = push(users, u3)

let payload = map_new()
let payload = map_set(payload, "total", 3)
let payload = map_set(payload, "users", users)

println("\n--- Users List Payload ---")
println(json_stringify(payload, true))

// Round-trip test
let serialized = json_stringify(payload)
let deserialized = json_parse(serialized)
println("\nRound-trip total: " + to_string(map_get(deserialized, "total")))

// CORS origins config
let config = map_set(config, "cors_origins", ["http://localhost:3000", "https://api.example.com"])
let config = map_set(config, "rate_limit_per_minute", 100)
let config = map_set(config, "jwt_secret", sha256("my-secret-key"))

let config_json = json_stringify(config, true)
println("Server Config:")
println(config_json)

// Save to file
file_write("/tmp/vietlang_server_config.json", config_json)
println("\nConfig saved to /tmp/vietlang_server_config.json")

// Read back
let loaded = json_parse(file_read("/tmp/vietlang_server_config.json"))
println("Loaded port: " + to_string(map_get(loaded, "server_port")))

file_delete("/tmp/vietlang_server_config.json")
println("\nJSON demo completed!")
