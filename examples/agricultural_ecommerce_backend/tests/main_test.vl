// ========================================================================
// Agricultural E-Commerce System — Test Suite
// Testing Categories, Product Queries, and ACID Inventory Rollback
// ========================================================================

import std.test
import examples.agricultural_ecommerce_backend.src.main

suite("Nong San Viet E-Commerce & SQLite ACID Test Suite")

test("Database initialization and category seeding", fn() {
    let db = init_agricultural_database()
    let cats = sqlite_query(db, "categories")
    assert_eq(cats.len(), 3, "Phải có đúng 3 danh mục nông sản ban đầu")
})

test("Filter products by category", fn() {
    let db = init_agricultural_database()
    // Category 2: Trai Cay Tuoi VietGAP (Xoai Cat & Sau Rieng)
    let fruits = sqlite_query(db, "products", fn(p) {
        return map_get(p, "category_id") == 2
    })
    assert_eq(fruits.len(), 2, "Danh mục Trái cây tươi phải có 2 sản phẩm")
})

test("Checkout order success and total amount calculation", fn() {
    let db = init_agricultural_database()
    // Order 5kg Gao ST25 Soc Trang (Price: 38,000 VND -> Total: 190,000 VND)
    let res = handle_checkout_order(db, "Tran Van Trong", 101, 5)
    assert_true(map_get(res, "success"), "Đặt hàng thành công")
    assert_eq(map_get(res, "total_amount"), 190000, "Tổng tiền 5kg gạo ST25 phải là 190.000 VNĐ")
})

test("Checkout order out-of-stock triggers ACID Transaction Rollback", fn() {
    let db = init_agricultural_database()
    // Product 103 (Sau Rieng Ri6) only has 80kg in stock. Requesting 500kg must fail & rollback!
    let res = handle_checkout_order(db, "Nguyen Thi B", 103, 500)
    assert_true(map_has(res, "error"), "Phải báo lỗi hết hàng")
    
    // Verify orders table was rolled back and no order was inserted
    let updated_db = map_get(res, "db")
    let orders = sqlite_query(updated_db, "orders")
    assert_eq(orders.len(), 0, "Giao dịch rollback: Bảng orders không được thêm đơn hàng lỗi")
})

test_summary()
