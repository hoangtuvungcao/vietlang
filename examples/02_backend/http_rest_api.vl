// ========================================================================
// VietLang Example: 02_backend/http_rest_api.vl
// High-Throughput HTTP/2 REST API Server with JSON Response & Middleware
// ========================================================================

import std.http_router
import std.http2
import std.json

let port = 8080
let server_cfg = http2_server_config(port, 200)

println("========================================================================")
println("VietLang Native HTTP/2 REST API Server")
println("Listening on: http://0.0.0.0:" + to_string(port))
println("Endpoints:")
println("  - GET  /api/health")
println("  - GET  /api/products")
println("  - POST /api/products")
println("========================================================================")

http_listen(server_cfg, fn(req) {
    let method = to_string(map_get(req, "method"))
    let path = to_string(map_get(req, "path"))
    let body = to_string(map_get(req, "body"))

    if method == "GET" && path == "/api/health" {
        let mut h = map_new()
        h = map_set(h, "status", "HEALTHY")
        h = map_set(h, "uptime_s", time_now())
        h = map_set(h, "engine", "VietLang HTTP/2 Multi-threaded")
        
        let mut res = map_new()
        res = map_set(res, "status_code", 200)
        res = map_set(res, "content_type", "application/json; charset=utf-8")
        res = map_set(res, "body", json_stringify(h, false))
        return res
    }

    if method == "GET" && path == "/api/products" {
        let mut items = []
        let mut p1 = map_new()
        p1 = map_set(p1, "id", 1)
        p1 = map_set(p1, "name", "Gạo ST25 Sóc Trăng")
        p1 = map_set(p1, "price", 185000)
        items = push(items, p1)

        let mut res = map_new()
        res = map_set(res, "status_code", 200)
        res = map_set(res, "content_type", "application/json; charset=utf-8")
        res = map_set(res, "body", json_stringify(items, false))
        return res
    }

    let mut not_found = map_new()
    not_found = map_set(not_found, "status_code", 404)
    not_found = map_set(not_found, "content_type", "application/json; charset=utf-8")
    not_found = map_set(not_found, "body", "{\"error\":\"Not Found\",\"path\":\"" + path + "\"}")
    return not_found
})
