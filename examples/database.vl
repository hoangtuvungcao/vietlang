// ===================================
// VietLang — Database & Query Builder Demo
// ===================================

println("🗄️  VietLang Database Demo")
println("==========================\n")

// --- Connection simulation ---
log_info("Connecting to PostgreSQL at localhost:5432/mydb")

// --- Query Builder Pattern ---
println("--- Query Builder ---\n")

// Build queries using the fluent API
let users_query = db_table("users")
println("Table: " + to_string(users_query))

// Execute raw SQL
println("\n--- Raw SQL Queries ---\n")
db_query("CREATE TABLE users (id SERIAL PRIMARY KEY, name VARCHAR(100), email VARCHAR(255), active BOOLEAN DEFAULT true)")
db_query("INSERT INTO users (name, email) VALUES ('Trong', 'trong@vietlang.dev')")
db_query("INSERT INTO users (name, email) VALUES ('Minh', 'minh@example.com')")
db_query("SELECT * FROM users WHERE active = true ORDER BY name LIMIT 10")
db_query("UPDATE users SET active = false WHERE id = 2")
db_query("DELETE FROM users WHERE active = false")

// --- Transaction pattern ---
println("\n--- Transaction Pattern ---\n")
log_info("BEGIN TRANSACTION")
db_query("INSERT INTO orders (user_id, total) VALUES (1, 99.99)")
db_query("UPDATE inventory SET stock = stock - 1 WHERE product_id = 42")
db_query("INSERT INTO audit_log (action, user_id) VALUES ('purchase', 1)")
log_info("COMMIT TRANSACTION")

// --- Data model with structs ---
println("\n--- Data Models ---\n")

struct User {
    id: Int,
    name: String,
    email: String,
    active: Bool
}

struct Order {
    id: Int,
    user_id: Int,
    total: Float,
    status: String
}

// Simulate fetching data
let users = [
    User { id: 1, name: "Trong", email: "trong@vietlang.dev", active: true },
    User { id: 2, name: "Minh", email: "minh@example.com", active: true },
    User { id: 3, name: "Lan", email: "lan@example.com", active: false }
]

println("All Users:")
for user in users {
    let status = match user.active {
        true => "Active",
        false => "Inactive"
    }
    println("  [" + to_string(user.id) + "] " + user.name + " <" + user.email + "> " + status)
}

// Filter active users
let active_users = users.filter(fn(u) { return u.active })
println("\nActive users count: " + to_string(active_users.len()))

// --- Connection Pool simulation ---
println("\n--- Connection Pool ---\n")
let pool_config = map_new()
let pool_config = map_set(pool_config, "min_connections", 5)
let pool_config = map_set(pool_config, "max_connections", 20)
let pool_config = map_set(pool_config, "idle_timeout_ms", 30000)
let pool_config = map_set(pool_config, "health_check_interval_ms", 5000)
println("Pool config: " + json_stringify(pool_config, true))

log_info("Connection pool initialized: min=5, max=20")
log_info("Health check: all connections healthy")

// --- Migration system ---
println("\n--- Migration System ---\n")
let migrations = [
    "001_create_users.sql",
    "002_create_orders.sql",
    "003_add_user_roles.sql",
    "004_create_audit_log.sql"
]

for m in migrations {
    log_info("Running migration: " + m)
}
println("All migrations completed")

println("\nDatabase demo completed!")
