// Consumer Application using community my_payment_sdk
import my_payment_sdk.src.main

println("=== Testing Community Module Integration in Consumer App ===")

let client = payment_client_new("production_secret_key_999", "MERCHANT_HA_NOI")
println("Payment Client Version: " + to_string(map_get(client, "version")))

let qr_url = payment_generate_vietqr_url("MB", "9999888877", 1250000, "ORDER_888")
println("Generated VietQR Image URL: " + qr_url)

let sig = payment_create_signature(client, "ORDER_888", 1250000)
println("HMAC SHA256 Signature: " + sig)

println("=== Community Package Integration: 100% SUCCESS ===")
