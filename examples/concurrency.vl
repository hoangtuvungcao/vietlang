// ===================================
// VietLang — Concurrency Demo
// Channels, spawn, mutex patterns
// ===================================

println(" VietLang Concurrency Demo")
println("=============================\n")

// --- Channels ---
println("--- Channels ---\n")
let ch = channel(100)
println("Channel created: " + to_string(ch))

// Simulate sending/receiving through channel
let messages = ["task-1", "task-2", "task-3", "task-4", "task-5"]
println("Sending " + to_string(messages.len()) + " messages through channel:")
for msg in messages {
    println("  → Sent: " + msg)
}

// --- Mutex (Thread-safe state) ---
println("\n--- Mutex ---\n")
let counter = mutex_new(0)
println("Mutex created: " + to_string(counter))

// --- Spawn tasks ---
println("\n--- Spawn Tasks ---\n")

fn worker(id: Int, task: String) -> String {
    let start = time_now_ms()
    log_info("Worker " + to_string(id) + " processing: " + task)
    // Simulate work
    let result = "result-" + to_string(id) + "-" + task
    log_info("Worker " + to_string(id) + " completed in " + to_string(time_now_ms() - start) + "ms")
    return result
}

// Simulate spawning workers
let tasks = ["parse-json", "query-db", "send-email", "resize-image", "generate-report"]
let mut results = []

for i in 0..5 {
    let task_name = tasks[i]
    log_info("Spawning worker " + to_string(i) + " for: " + task_name)
    spawn(task_name)
    let result = worker(i, task_name)
    results = push(results, result)
}

println("\nAll tasks completed!")
println("Results: " + to_string(results))

// --- Producer-Consumer Pattern ---
println("\n--- Producer-Consumer Pattern ---\n")

fn producer(items: [String]) {
    for item in items {
        log_debug("Producing: " + item)
    }
    log_info("Producer finished, " + to_string(items.len()) + " items produced")
}

fn consumer(count: Int) {
    for i in 0..count {
        log_debug("Consuming item " + to_string(i))
    }
    log_info("Consumer finished, " + to_string(count) + " items consumed")
}

let work_items = ["order-1", "order-2", "order-3", "order-4", "order-5"]
producer(work_items)
consumer(work_items.len())

// --- Work Stealing Scheduler Pattern ---
println("\n--- Work Stealing Scheduler ---\n")

fn schedule_task(name: String, priority: Int) {
    let task = map_new()
    let task = map_set(task, "name", name)
    let task = map_set(task, "priority", priority)
    let task = map_set(task, "status", "queued")
    let task = map_set(task, "created_at", time_now())
    println("  Scheduled: " + json_stringify(task))
}

schedule_task("critical-fix", 1)
schedule_task("feature-deploy", 2)
schedule_task("log-rotation", 3)
schedule_task("cache-warmup", 4)
schedule_task("analytics-report", 5)

println("\n Concurrency demo completed!")
