// ===================================================
// Realtime WebSocket & Socket Communication Test Suite
// Demonstrating:
// - RFC 6455 WebSocket Handshake calculation
// - WebSocket Text Frame encoding & decoding
// - Multi-room client broadcasting
// - Low-level TCP & UDP network messaging
// ===================================================

import std.test
import std.strings
import std.socket
import std.websocket

suite("Realtime WebSocket & Socket Test Suite")

test("RFC 6455 WebSocket Handshake Accept Key", fn() {
    // Standard test vector from RFC 6455 Section 1.3
    let client_key = "dGhlIHNhbXBsZSBub25jZQ=="
    let accept_key = ws_accept_key(client_key)
    
    // Expected response key: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=
    assert_eq(accept_key, "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=", "RFC 6455 SHA1 + Base64 Accept Key mismatch")

    let handshake_header = ws_handshake_response(client_key)
    assert_true(handshake_header.contains("101 Switching Protocols"), "Missing 101 status code")
    assert_true(handshake_header.contains("Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo="), "Missing accept header")
})

test("WebSocket Text Frame Encoding", fn() {
    let frame = ws_encode_text_frame("Hello, VietLang Realtime!")
    assert_eq(map_get(frame, "opcode"), 1, "Opcode should be 1 (Text Frame)")
    assert_eq(map_get(frame, "payload"), "Hello, VietLang Realtime!", "Payload mismatch")
    assert_true(map_get(frame, "fin"), "FIN bit should be true")
})

test("WebSocket Room Broadcasting Hub", fn() {
    let mut hub = ws_room_manager_new()
    hub = ws_room_join(hub, "chat_room_vietnam", "client_usr_101")
    hub = ws_room_join(hub, "chat_room_vietnam", "client_usr_102")
    hub = ws_room_join(hub, "chat_room_vietnam", "client_usr_103")

    let message_payload = map_set(map_set(map_new(), "sender", "Alice"), "text", "Xin chao VietLang WebSocket!")
    let broadcast_packet = ws_room_broadcast(hub, "chat_room_vietnam", "NEW_MESSAGE", message_payload)

    assert_eq(map_get(broadcast_packet, "recipients"), 3, "Broadcast must reach all 3 room members")
    assert_eq(map_get(broadcast_packet, "event"), "NEW_MESSAGE", "Event name mismatch")
})

test("Low-Level Socket Ping", fn() {
    // Ping local DNS (127.0.0.1 on closed port returns false safely without crashing)
    let ping_result = socket_ping("127.0.0.1", 59999, 100)
    assert_false(ping_result, "Ping on closed port must safely return false")
})

test("UDP Packet Dispatch", fn() {
    let sent = socket_udp_send("127.0.0.1", 9999, "VIETLANG_UDP_PING")
    assert_true(sent, "UDP packet should dispatch without error")
})

test_summary()
