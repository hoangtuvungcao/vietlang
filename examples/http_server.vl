// ===================================
// VietLang — HTTP Server Demo
// Built-in HTTP server, zero dependency
// ===================================

println("🌐 VietLang HTTP Server Example")
println("================================\n")

// --- Middleware simulation ---
fn cors_middleware(req) {
    log_info("CORS: Allowing all origins")
    return true
}

fn auth_middleware(req) {
    log_info("AUTH: Checking authentication")
    return true
}

fn rate_limit_check(req) {
    log_info("RATE: Checking rate limit")
    return true
}

// --- Route Handlers ---
fn handle_users_list() {
    let users = [
        map_set(map_set(map_new(), "name", "Trong"), "email", "trong@vietlang.dev"),
        map_set(map_set(map_new(), "name", "Minh"), "email", "minh@vietlang.dev"),
        map_set(map_set(map_new(), "name", "Lan"), "email", "lan@vietlang.dev")
    ]
    return json_stringify(users, true)
}

fn handle_user_by_id(id: Int) {
    let user = map_new()
    let user = map_set(user, "id", id)
    let user = map_set(user, "name", "Trong")
    let user = map_set(user, "email", "trong@vietlang.dev")
    let user = map_set(user, "role", "admin")
    return json_stringify(user, true)
}

fn handle_health() {
    let status = map_new()
    let status = map_set(status, "status", "healthy")
    let status = map_set(status, "version", "0.1.0")
    let status = map_set(status, "uptime_s", time_now())
    return json_stringify(status)
}

// --- Demo: show what the server would respond ---
println("📋 Route Handlers Demo:\n")

println("GET /health")
println(handle_health())
println("")

println("GET /users")
println(handle_users_list())
println("")

println("GET /users/1")
println(handle_user_by_id(1))
println("")

// --- Crypto features ---
println("\nSecurity Features:\n")
let password = "my_secure_password"
let hashed = sha256(password)
println("Password hash: " + hashed)

let token_id = uuid()
println("Session UUID: " + token_id)

let encoded = base64_encode("VietLang:BackendFirst")
println("Base64 token: " + encoded)

// --- To actually start the server, uncomment: ---
// println("\nStarting server on port 8080...")
// http_listen(8080, "handler")

println("\nHTTP Server demo completed!")
println("To start a real server, use: http_listen(8080, handler)")
