// ========================================================================
// VietLang Multi-Database Architecture Demo (SQLite, MySQL, PostgreSQL)
// ========================================================================

import std.db
import std.db_sqlite
import std.db_mysql
import std.db_postgres
import std.test

suite("VietLang Enterprise Multi-Database Engine Suite")

test("1. Unified SQLite File Connection & Relational Querying", fn() {
    let db = db_connect(":memory:")
    assert_eq(map_get(db, "driver"), "sqlite", "Driver phai la sqlite")

    db_exec(db, "CREATE TABLE demo_products (id INT PRIMARY KEY, name TEXT, price INT);")
    let affected = db_execute(db, "INSERT INTO demo_products (id, name, price) VALUES (?, ?, ?);", [1, "Gao ST25", 38000])
    assert_eq(affected, 1, "Phai insert thanh cong 1 ban ghi")

    let rows = db_query(db, "SELECT * FROM demo_products WHERE id = ?;", [1])
    assert_eq(rows.len(), 1, "Phai query ra dung 1 ban ghi")
    let row = rows[0]
    assert_eq(map_get(row, "name"), "Gao ST25", "Ten san pham phai khop")
    assert_eq(map_get(row, "price"), 38000, "Gia phai khop")
})

test("2. MySQL Connection Pool & Protocol Abstraction", fn() {
    let db = db_connect("mysql://root:secret@127.0.0.1:3306/agricultural_db")
    assert_eq(map_get(db, "driver"), "mysql", "Driver phai la mysql")
    assert_eq(map_get(db, "status"), "CONNECTED", "Trang thai phai CONNECTED")

    let pool = map_get(db, "conn")
    let cfg = map_get(pool, "config")
    assert_eq(map_get(cfg, "port"), 3306, "Port MySQL phai la 3306")
    assert_eq(map_get(cfg, "database"), "agricultural_db", "Database phai khop")
})

test("3. PostgreSQL Connection & Schema Protocol", fn() {
    let db = db_connect("postgres://postgres:pwd@127.0.0.1:5432/agricultural_db?sslmode=disable")
    assert_eq(map_get(db, "driver"), "postgres", "Driver phai la postgres")
    assert_eq(map_get(db, "status"), "CONNECTED", "Trang thai phai CONNECTED")

    let client = map_get(db, "conn")
    assert_true(postgres_is_healthy(client), "PostgreSQL client phai healthy")
})

test_summary()
