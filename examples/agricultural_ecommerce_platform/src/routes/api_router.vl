// ========================================================================
// Module: routes/api_router.vl
// Unified Enterprise REST API Dispatcher
// ========================================================================

import examples.agricultural_ecommerce_platform.src.repositories.product_repo
import examples.agricultural_ecommerce_platform.src.repositories.order_repo
import examples.agricultural_ecommerce_platform.src.services.order_service
import examples.agricultural_ecommerce_platform.src.controllers.admin_controller
import std.db_sqlite

fn api_response(status_code: Int, data, message: String = "OK") {
    let mut resp = map_new()
    resp = map_set(resp, "status_code", status_code)
    resp = map_set(resp, "data", data)
    resp = map_set(resp, "message", message)
    return resp
}

fn api_error(status_code: Int, error_msg: String) {
    let mut resp = map_new()
    resp = map_set(resp, "status_code", status_code)
    resp = map_set(resp, "error", error_msg)
    return resp
}

fn api_dispatch_request(db, method: String, path: String, body_map) {
    if method == "GET" && path == "/api/v1/health" {
        let mut health_data = map_new()
        health_data = map_set(health_data, "status", "HEALTHY")
        health_data = map_set(health_data, "uptime", time_now())
        health_data = map_set(health_data, "engine", "VietLang SQLite ACID Relational DB")
        health_data = map_set(health_data, "version", "0.1.0-enterprise")
        return api_response(200, health_data, "System Operational")
    }

    if method == "GET" && path == "/api/v1/categories" {
        let cats = product_repo_get_categories(db)
        return api_response(200, cats, "Lay danh muc thanh cong")
    }

    if method == "GET" && path == "/api/v1/vouchers" {
        let vouchers = product_repo_get_vouchers(db)
        return api_response(200, vouchers, "Lay danh sach ma giam gia thanh cong")
    }

    if method == "GET" && path == "/api/v1/cooperatives" {
        let coops = product_repo_get_cooperatives(db)
        return api_response(200, coops, "Lay danh sach hop tac xa nong nghiep thanh cong")
    }

    if method == "GET" && path == "/api/v1/flash_sales" {
        let prods = sqlite_query(db, "products", fn(p) {
            let orig = map_get(p, "original_price")
            let cur = map_get(p, "price")
            let diff = orig - cur
            return diff >= 20000
        })
        return api_response(200, prods, "Lay danh sach flash sale thanh cong")
    }

    if method == "GET" && path == "/api/v1/reviews" {
        let reviews = sqlite_query(db, "reviews", none)
        return api_response(200, reviews, "Lay danh sach danh gia thanh cong")
    }

    if method == "POST" && path == "/api/v1/reviews" {
        let prod_id = map_get(body_map, "product_id")
        let author = to_string(map_get(body_map, "author_name"))
        let rating = map_get(body_map, "rating")
        let comment = to_string(map_get(body_map, "comment"))

        let r = map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", time_now()), "product_id", prod_id), "author_name", author), "rating", rating), "comment", comment), "created_at", time_now())
        let db2 = sqlite_insert(db, "reviews", r)
        return api_response(201, r, "Gui danh gia san pham thanh cong")
    }

    if method == "GET" && path == "/api/v1/products" {
        let mut cat_id = 0
        if map_has(body_map, "category_id") {
            cat_id = map_get(body_map, "category_id")
        }
        let mut q = ""
        if map_has(body_map, "query") {
            q = to_string(map_get(body_map, "query"))
        }
        let mut max_p = 0
        if map_has(body_map, "max_price") {
            max_p = map_get(body_map, "max_price")
        }
        let mut region = ""
        if map_has(body_map, "region") {
            region = to_string(map_get(body_map, "region"))
        }
        let mut cert = ""
        if map_has(body_map, "cert") {
            cert = to_string(map_get(body_map, "cert"))
        }

        let prods = product_repo_get_all(db, cat_id, q, max_p, region, cert)
        return api_response(200, prods, "Lay danh sach san pham thanh cong")
    }

    if method == "GET" && path == "/api/v1/admin/analytics" {
        let analytics = handle_admin_analytics(db)
        return api_response(200, analytics, "Thong ke admin")
    }

    if method == "POST" && path == "/api/v1/admin/restock" {
        let prod_id = map_get(body_map, "product_id")
        let amount = map_get(body_map, "amount")
        let db2 = sqlite_update(db, "products", fn(p) {
            return map_get(p, "id") == prod_id
        }, fn(p) {
            let cur_stock = map_get(p, "stock")
            return map_set(p, "stock", cur_stock + amount)
        })
        return api_response(200, map_set(map_new(), "product_id", prod_id), "Nhap hang thanh cong")
    }

    if method == "GET" && path == "/api/v1/orders/track" {
        let mut q = ""
        if map_has(body_map, "query") {
            q = to_string(map_get(body_map, "query"))
        }
        let orders = order_service_track_order(db, q)
        return api_response(200, orders, "Tra cuu don hang thanh cong")
    }

    if method == "POST" && path == "/api/v1/orders/checkout" {
        let mut user_id = 0
        if map_has(body_map, "user_id") {
            user_id = map_get(body_map, "user_id")
        }
        let customer_name = to_string(map_get(body_map, "customer_name"))
        let phone = to_string(map_get(body_map, "phone"))
        let address = to_string(map_get(body_map, "address"))
        let mut city = "TP. Ho Chi Minh"
        if map_has(body_map, "city") {
            city = to_string(map_get(body_map, "city"))
        }
        let mut pay_method = "COD"
        if map_has(body_map, "payment_method") {
            pay_method = to_string(map_get(body_map, "payment_method"))
        }
        let items = map_get(body_map, "items")
        let mut voucher = ""
        if map_has(body_map, "voucher") {
            voucher = to_string(map_get(body_map, "voucher"))
        }
        
        let res = order_service_checkout(db, user_id, customer_name, phone, address, city, pay_method, items, voucher)
        if map_has(res, "error") {
            return api_error(400, to_string(map_get(res, "error")))
        }
        return api_response(201, res, "Dat hang thanh cong")
    }

    return api_error(404, "Endpoint not found: " + method + " " + path)
}
