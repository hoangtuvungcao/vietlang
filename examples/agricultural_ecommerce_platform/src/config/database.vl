    let p5 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 105), "category_id", 3), "coop_id", 4), "name", "Tra O Long Cau Dat Da Lat Thuong Hang"), "price", 195000), "original_price", 230000), "unit", "hop_250g"), "stock", 190), "origin", "Da Lat"), "region", "Tay Nguyen"), "cert", "OCOP 4 Sao"), "rating", 4.8), "review_count", 86), "image", "tra_olong.jpg"), "description", "Thu hai luc sang som tren do cao 1650m, len men ban phan tao nen huong hoa co tu nhien cung hau vi ngot sau."), "harvest_date", "Thang 08/2026")
    let p6 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 106), "category_id", 4), "coop_id", 4), "name", "Dau Tay Da Lat Giong Nhat Huu Co"), "price", 160000), "original_price", 190000), "unit", "hop_500g"), "stock", 55), "origin", "Da Lat"), "region", "Tay Nguyen"), "cert", "VietGAP"), "rating", 4.9), "review_count", 74), "image", "dau_tay.jpg"), "description", "Trong trong nha mang cong nghe cao khong hoa chat, qua do mong, vi chua ngot thanh tao va thom nhe."), "harvest_date", "Thang 08/2026")
    let p7 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 107), "category_id", 5), "coop_id", 1), "name", "Hat Dieu Binh Phuoc Rang Muoi Loai A Co Lon"), "price", 175000), "original_price", 210000), "unit", "hop_500g"), "stock", 240), "origin", "Binh Phuoc"), "region", "Dong Nam Bo"), "cert", "OCOP 5 Sao"), "rating", 4.9), "review_count", 130), "image", "hat_dieu.jpg"), "description", "Hat dieu con nguyen vo lua rang cui truyen thong, giu tron vi beo bui dac trung va do gion rum."), "harvest_date", "Thang 06/2026")
