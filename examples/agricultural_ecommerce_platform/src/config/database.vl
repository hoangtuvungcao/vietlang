    let c4 = map_set(map_set(map_set(map_set(map_set(map_new(), "id", 4), "code", "RAU_CU_HUU_CO"), "name", "Rau Cu Qua Huu Co"), "icon", "vegetable"), "description", "Rau cu Da Lat, ca chua cherry, dau tay organic")
