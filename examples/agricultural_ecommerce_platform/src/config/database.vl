    let p1 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 101), "category_id", 1), "coop_id", 1), "name", "Gao ST25 Soc Trang Dat Giai Nhat The Gioi"), "price", 38000), "original_price", 45000), "unit", "kg"), "stock", 650), "origin", "Soc Trang"), "region", "Mien Tay"), "cert", "OCOP 5 Sao"), "rating", 5.0), "review_count", 142), "image", "gao_st25.jpg"), "description", "Hat gao thon dai, trong bong, khi nau com thom huong la dua tu nhien, com de ngay ca khi de nguoi."), "harvest_date", "Thang 08/2026")
