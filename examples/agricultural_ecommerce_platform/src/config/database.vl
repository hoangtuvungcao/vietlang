    let co4 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 4), "name", "HTX Rau Cu Sach Cau Dat Farm"), "location", "Da Lat, Lam Dong"), "cert", "VietGAP"), "founded_year", 2010), "contact", "0263.3555.666"), "hectares", 150), "farmer_count", 95)
    let co5 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 5), "name", "HTX Nong San Luc Ngan Bac Giang"), "location", "Bac Giang"), "cert", "GlobalGAP"), "founded_year", 2014), "contact", "0204.3888.555"), "hectares", 280), "farmer_count", 165)
    let co6 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 6), "name", "HTX Nuoc Mam & Gia Vi Dao Ngoc"), "location", "Phu Quoc, Kien Giang"), "cert", "OCOP 5 Sao"), "founded_year", 2006), "contact", "0297.3999.111"), "hectares", 80), "farmer_count", 60)
    db = sqlite_insert(db, "farm_cooperatives", co1)
    db = sqlite_insert(db, "farm_cooperatives", co2)
    db = sqlite_insert(db, "farm_cooperatives", co3)
    db = sqlite_insert(db, "farm_cooperatives", co4)
    db = sqlite_insert(db, "farm_cooperatives", co5)
    db = sqlite_insert(db, "farm_cooperatives", co6)

    // 4. Seed Categories
    let c1 = map_set(map_set(map_set(map_set(map_set(map_new(), "id", 1), "code", "GAO_LUONG_THUC"), "name", "Gao & Luong Thuc"), "icon", "rice"), "description", "Gao ST25, nep cai hoa vang, gao Nang Thom, ngu coc")
    let c2 = map_set(map_set(map_set(map_set(map_set(map_new(), "id", 2), "code", "TRAI_CAY_VIETGAP"), "name", "Trai Cay Dac San"), "icon", "fruit"), "description", "Xoai cat, sau rieng Ri6, buoi da xanh, vai thieu, nhan long")
    let c3 = map_set(map_set(map_set(map_set(map_set(map_new(), "id", 3), "code", "CA_PHE_TRA"), "name", "Ca Phe & Tra Cao Cap"), "icon", "coffee"), "description", "Ca phe Robusta Cu M'gar, tra O Long Cau Dat, che Tan Cuong")
    let c4 = map_set(map_set(map_set(map_set(map_set(map_new(), "id", 4), "code", "RAU_CU_HUU_CO"), "name", "Rau Cu Qua Huu Co"), "icon", "vegetable"), "description", "Dau tay Da Lat, ca chua cherry, nam linh chi, bo sap")
    let c5 = map_set(map_set(map_set(map_set(map_set(map_new(), "id", 5), "code", "HAT_SAY_KHO"), "name", "Hat & Nong San Say"), "icon", "nut"), "description", "Hat dieu Binh Phuoc, mac ca Tay Nguyen, hat sen Dong Thap")
    let c6 = map_set(map_set(map_set(map_set(map_set(map_new(), "id", 6), "code", "MAT_ONG_GIA_VI"), "name", "Mat Ong & Gia Vi"), "icon", "honey"), "description", "Mat ong U Minh, tieu Phu Quoc, toi Ly Son, que Tra Bong, nuoc mam")
    db = sqlite_insert(db, "categories", c1)
    db = sqlite_insert(db, "categories", c2)
    db = sqlite_insert(db, "categories", c3)
    db = sqlite_insert(db, "categories", c4)
    db = sqlite_insert(db, "categories", c5)
    db = sqlite_insert(db, "categories", c6)

