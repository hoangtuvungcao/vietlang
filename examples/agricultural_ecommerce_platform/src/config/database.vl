import std.db_sqlite
import std.security

fn db_init_and_migrate() {
    let mut db = sqlite_open(":memory:")

    // 1. Create Tables
    db = sqlite_exec(db, "CREATE TABLE users (id INT, email TEXT, password_hash TEXT, name TEXT, phone TEXT, role TEXT, created_at INT)")
    db = sqlite_exec(db, "CREATE TABLE categories (id INT, code TEXT, name TEXT, icon TEXT, description TEXT)")
    db = sqlite_exec(db, "CREATE TABLE farm_cooperatives (id INT, name TEXT, location TEXT, cert TEXT, founded_year INT)")
    db = sqlite_exec(db, "CREATE TABLE products (id INT, category_id INT, coop_id INT, name TEXT, price INT, original_price INT, unit TEXT, stock INT, origin TEXT, region TEXT, cert TEXT, rating Float, review_count INT, image TEXT, description TEXT, harvest_date TEXT)")
    db = sqlite_exec(db, "CREATE TABLE vouchers (code TEXT, discount_type TEXT, discount_val INT, min_order INT, description TEXT, is_active BOOL)")
    db = sqlite_exec(db, "CREATE TABLE orders (id INT, user_id INT, customer_name TEXT, phone TEXT, address TEXT, city TEXT, payment_method TEXT, subtotal INT, discount INT, shipping_fee INT, total INT, status TEXT, created_at INT)")
    db = sqlite_exec(db, "CREATE TABLE order_items (order_id INT, product_id INT, product_name TEXT, unit_price INT, quantity INT, subtotal INT)")
    db = sqlite_exec(db, "CREATE TABLE reviews (id INT, product_id INT, author_name TEXT, rating INT, comment TEXT, created_at INT)")

    // 2. Seed Users
    let u1 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 1), "email", "admin@nongsanviet.vn"), "password_hash", security_hash_password("Admin@2026")), "name", "Tong Quan Tri"), "phone", "0901888999"), "role", "ADMIN"), "created_at", time_now())
    let u2 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 2), "email", "khachhang@gmail.com"), "password_hash", security_hash_password("Khach@123")), "name", "Nguyen Van An"), "phone", "0901234567"), "role", "CUSTOMER"), "created_at", time_now())
    db = sqlite_insert(db, "users", u1)
    db = sqlite_insert(db, "users", u2)

    // 3. Seed Farm Cooperatives
    let co1 = map_set(map_set(map_set(map_set(map_set(map_new(), "id", 1), "name", "HTX Nong Nghiep Huu Co My Xuyen"), "location", "Soc Trang"), "cert", "OCOP 5 Sao"), "founded_year", 2012)
