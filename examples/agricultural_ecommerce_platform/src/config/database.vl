    let p11 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 111), "category_id", 4), "coop_id", 4), "name", "Ca Chua Cherry Da Lat Ngot Gion Organic"), "price", 65000), "original_price", 78000), "unit", "hop_500g"), "stock", 120), "origin", "Da Lat"), "region", "Tay Nguyen"), "cert", "VietGAP"), "rating", 4.8), "review_count", 54), "image", "ca_chua.jpg"), "description", "Qua nho mong do ruc, vo mong mong nuoc, vi ngot thanh giam do chua tu nhien thich hop an song va lam salad."), "harvest_date", "Thang 08/2026")
    let p12 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 112), "category_id", 1), "coop_id", 1), "name", "Nep Cai Hoa Vang Bac Bo Dac San"), "price", 42000), "original_price", 50000), "unit", "kg"), "stock", 400), "origin", "Hai Duong"), "region", "Mien Bac"), "cert", "OCOP 4 Sao"), "rating", 4.9), "review_count", 88), "image", "nep_cai.jpg"), "description", "Giong nep truyen thong hat tron deu, deo thom lung, thich hop lam xoi, banh chung va ruou nep thom ngon."), "harvest_date", "Thang 07/2026")

