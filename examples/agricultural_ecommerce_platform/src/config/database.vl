    // 7. Seed Reviews
    let r1 = map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 1), "product_id", 101), "author_name", "Tran Minh Tam"), "rating", 5), "comment", "Gao rat thom va deo, de nguoi an van ngon, dung chuan ST25 chinh goc!"), "created_at", time_now())
    let r2 = map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 2), "product_id", 104), "author_name", "Le Hoang Nam"), "rating", 5), "comment", "Ca phe moc dam da dung gu, pha phin hay pha espresso deu ra lop crema rat dep."), "created_at", time_now())
    db = sqlite_insert(db, "reviews", r1)
    db = sqlite_insert(db, "reviews", r2)

    return db
}
