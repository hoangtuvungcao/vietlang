// ========================================================================
// Nong San Viet (VietCleanAgri) Enterprise Backend Platform
// Relational Database Schema & Agricultural Data Seed (std.db_sqlite)
// ========================================================================

import std.db_sqlite
import std.security

fn db_init_and_migrate() {
    let mut db = sqlite_open(":memory:")

    // 1. Relational Schema Definition
    db = sqlite_exec(db, "CREATE TABLE users (id INT, email TEXT, password_hash TEXT, name TEXT, phone TEXT, role TEXT, created_at INT)")
    db = sqlite_exec(db, "CREATE TABLE categories (id INT, code TEXT, name TEXT, icon TEXT, description TEXT)")
    db = sqlite_exec(db, "CREATE TABLE farm_cooperatives (id INT, name TEXT, location TEXT, cert TEXT, founded_year INT, contact TEXT, hectares INT, farmer_count INT)")
    db = sqlite_exec(db, "CREATE TABLE products (id INT, category_id INT, coop_id INT, name TEXT, price INT, original_price INT, unit TEXT, stock INT, origin TEXT, region TEXT, cert TEXT, rating FLOAT, review_count INT, image_data TEXT, description TEXT, harvest_date TEXT)")
    db = sqlite_exec(db, "CREATE TABLE vouchers (code TEXT, discount_type TEXT, discount_val INT, min_order INT, description TEXT, is_active BOOL)")
    db = sqlite_exec(db, "CREATE TABLE orders (id TEXT, user_id INT, customer_name TEXT, phone TEXT, address TEXT, subtotal INT, discount INT, shipping_fee INT, total INT, payment_method TEXT, status TEXT, created_at INT)")
    db = sqlite_exec(db, "CREATE TABLE order_items (id INT, order_id TEXT, product_id INT, product_name TEXT, unit_price INT, quantity INT, subtotal INT)")
    db = sqlite_exec(db, "CREATE TABLE reviews (id INT, product_id INT, author_name TEXT, rating INT, comment TEXT, created_at INT)")

    // 2. Seed Users
    let u1 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 1), "email", "admin@nongsanviet.vn"), "password_hash", security_hash_password("Admin@2026")), "name", "Tong Quan Tri"), "phone", "0901888999"), "role", "ADMIN"), "created_at", time_now())
    let u2 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 2), "email", "khachhang@gmail.com"), "password_hash", security_hash_password("Khach@123")), "name", "Nguyen Van An"), "phone", "0901234567"), "role", "CUSTOMER"), "created_at", time_now())
    db = sqlite_insert(db, "users", u1)
    db = sqlite_insert(db, "users", u2)

    // 3. Seed 6 Farm Cooperatives
    let co1 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 1), "name", "HTX Nong Nghiep Huu Co My Xuyen"), "location", "Soc Trang"), "cert", "OCOP 5 Sao"), "founded_year", 2012), "contact", "0299.3888.999"), "hectares", 350), "farmer_count", 180)
    let co2 = map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_set(map_new(), "id", 2), "name", "HTX Cay An Trai Hoa Loc"), "location", "Tien Giang"), "cert", "GlobalGAP"), "founded_year", 2008), "contact", "0273.3777.888"), "hectares", 220), "farmer_count", 140)
