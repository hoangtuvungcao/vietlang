    db = sqlite_insert(db, "farm_cooperatives", co1)
    db = sqlite_insert(db, "farm_cooperatives", co2)
    db = sqlite_insert(db, "farm_cooperatives", co3)
    db = sqlite_insert(db, "farm_cooperatives", co4)

    // 4. Seed Categories
    let c1 = map_set(map_set(map_set(map_set(map_set(map_new(), "id", 1), "code", "GAO_LUONG_THUC"), "name", "Gao & Luong Thuc"), "icon", "rice"), "description", "Gao ST25, nep cai hoa vang, ngu coc dinh duong")
