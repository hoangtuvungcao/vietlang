// ========================================================================
// Module: services/auth_service.vl
// User Authentication, Password Verification, and JWT Token Issuing
// ========================================================================

import std.security
import std.jwt
import examples.agricultural_ecommerce_platform.src.repositories.user_repo

fn auth_service_register(db, name: String, email: String, param3: String, param4: String = "", role: String = "CUSTOMER") {
    let mut phone = ""
    let mut password = param3
    if param4 != "" {
        phone = param3
        password = param4
    }

    let existing = user_repo_find_by_email(db, email)
    if map_has(existing, "id") {
        let mut err = map_new()
        err = map_set(err, "error", "Email đã tồn tại trên hệ thống!")
        return err
    }

    let user_id = time_now() % 1000000
    let pwd_hash = security_hash_password(password)

    let mut user = map_new()
    user = map_set(user, "id", user_id)
    user = map_set(user, "email", email)
    user = map_set(user, "password_hash", pwd_hash)
    user = map_set(user, "name", name)
    user = map_set(user, "phone", phone)
    user = map_set(user, "role", role)
    user = map_set(user, "created_at", time_now())

    let updated_db = user_repo_create(db, user)

    let token = jwt_sign(user_id, role, 86400)
    let mut res = map_new()
    res = map_set(res, "success", true)
    res = map_set(res, "token", token)

    let mut u_info = map_new()
    u_info = map_set(u_info, "id", user_id)
    u_info = map_set(u_info, "name", name)
    u_info = map_set(u_info, "email", email)
    u_info = map_set(u_info, "phone", phone)
    u_info = map_set(u_info, "role", role)

    res = map_set(res, "user", u_info)
    res = map_set(res, "db", updated_db)
    return res
}

fn auth_service_login(db, email: String, password: String) {
    let user = user_repo_find_by_email(db, email)
    if !map_has(user, "id") {
        let mut err = map_new()
        err = map_set(err, "error", "Email hoặc mật khẩu không chính xác!")
        return err
    }

    let pwd_hash = to_string(map_get(user, "password_hash"))
    if !security_verify_password(password, pwd_hash) {
        let mut err = map_new()
        err = map_set(err, "error", "Email hoặc mật khẩu không chính xác!")
        return err
    }

    let user_id = map_get(user, "id")
    let role = to_string(map_get(user, "role"))
    let token = jwt_sign(user_id, role, 86400)

    let mut res = map_new()
    res = map_set(res, "success", true)
    res = map_set(res, "token", token)

    let mut u_info = map_new()
    u_info = map_set(u_info, "id", user_id)
    u_info = map_set(u_info, "name", map_get(user, "name"))
    u_info = map_set(u_info, "email", email)
    u_info = map_set(u_info, "phone", map_get(user, "phone"))
    u_info = map_set(u_info, "role", role)

    res = map_set(res, "user", u_info)
    return res
}

fn auth_service_get_all_users(db) {
    return user_repo_get_all(db)
}
