// ========================================================================
// Module: repositories/user_repo.vl
// Data Access Object for Users in Relational Database
// ========================================================================

import std.db_sqlite

fn user_repo_find_by_email(db, email: String) {
    let rows = sqlite_query(db, "SELECT * FROM users WHERE email = ? LIMIT 1;", [email])
    if rows.len() > 0 {
        return rows[0]
    }
    return map_new()
}

fn user_repo_find_by_id(db, id: Int) {
    let rows = sqlite_query(db, "SELECT * FROM users WHERE id = ? LIMIT 1;", [id])
    if rows.len() > 0 {
        return rows[0]
    }
    return map_new()
}

fn user_repo_get_all(db) {
    return sqlite_query(db, "SELECT id, email, name, phone, role, created_at FROM users ORDER BY id ASC;")
}

fn user_repo_create(db, user_map) {
    let id = map_get(user_map, "id")
    let email = to_string(map_get(user_map, "email"))
    let pwd = to_string(map_get(user_map, "password_hash"))
    let name = to_string(map_get(user_map, "name"))
    let phone = to_string(map_get(user_map, "phone"))
    let role = to_string(map_get(user_map, "role"))
    let created = map_get(user_map, "created_at")

    sqlite_execute(db, "INSERT INTO users (id, email, password_hash, name, phone, role, created_at) VALUES (?, ?, ?, ?, ?, ?, ?);", [id, email, pwd, name, phone, role, created])
    return db
}
