// ========================================================================
// VietLang Native Concurrency & Channel Streaming Engine
// CSP Model: Goroutines (spawn) + Async Thread-Safe Channels
// ========================================================================

println("========================================================================")
println("VietLang Native Concurrency & Channel Communication Suite")
println("========================================================================")

// 1. Unbounded Channel Ping-Pong Demo
println("\n[1] Testing Thread-Safe Channel Send & Recv...")
let ch = channel_new()

spawn(fn() {
    println("[Worker Thread 1] Sending message 1...")
    channel_send(ch, "Hello from Background Worker 1!")
    thread_sleep(50)
    println("[Worker Thread 1] Sending message 2...")
    channel_send(ch, "Message #2: Processing Order #1001")
})

let msg1 = channel_recv(ch)
println("[Main Thread] Received: " + to_string(msg1))

let msg2 = channel_recv(ch)
println("[Main Thread] Received: " + to_string(msg2))

// 2. Multi-Worker Producer/Consumer Pipeline
println("\n[2] Testing Multi-Worker Producer/Consumer Pipeline...")
let job_queue = channel_new(10) // Bounded channel (Capacity: 10)
let result_queue = channel_new()

// Spawn 3 Workers
let mut w = 1
while w <= 3 {
    let worker_id = w
    spawn(fn() {
        let mut running = true
        while running {
            let task_item = channel_recv(job_queue)
            if task_item == "STOP" {
                running = false
            } else {
                let processed = "[Worker " + to_string(worker_id) + "] Processed: " + to_string(task_item)
                channel_send(result_queue, processed)
            }
        }
    })
    w += 1
}

// Produce 6 Jobs
let jobs = ["Order_A", "Order_B", "Order_C", "Order_D", "Order_E", "Order_F"]
for job in jobs {
    channel_send(job_queue, job)
}

// Collect 6 Results
let mut res_count = 0
while res_count < 6 {
    let res = channel_recv(result_queue)
    println(" -> Pipeline Result: " + to_string(res))
    res_count += 1
}

// Send Stop signals
channel_send(job_queue, "STOP")
channel_send(job_queue, "STOP")
channel_send(job_queue, "STOP")

println("\n[3] Testing Non-Blocking Channel Try-Recv...")
let try_res = channel_try_recv(job_queue)
println("Try recv on empty channel: ok=" + to_string(map_get(try_res, "ok")))

println("\n========================================================================")
println("VietLang Native Concurrency: 100% SUCCESS!")
println("========================================================================")
