// ===================================================
// VietLang Database Drivers & Adapters Suite (SQLite, MySQL, Postgres)
// Validating Relational Database Engines & Protocols:
// - Embedded SQLite with In-Memory Tables & Transaction Rollbacks (std.db_sqlite)
// - MySQL Connection Pooling & DSN Engine (std.db_mysql)
// - PostgreSQL Schema Engine & Health Checks (std.db_postgres)
// ===================================================

import std.test
import std.db_sqlite
import std.db_mysql
import std.db_postgres

suite("Database Drivers & Storage Engine Suite")

test("SQLite In-Memory Engine: Tables, Inserts, Queries", fn() {
    let mut db = sqlite_open(":memory:")
    db = sqlite_exec(db, "CREATE TABLE users (id INT, name TEXT, email TEXT)")

    let u1 = map_set(map_set(map_new(), "id", 1), "name", "Trong")
    let u2 = map_set(map_set(map_new(), "id", 2), "name", "Minh")
    db = sqlite_insert(db, "users", u1)
    db = sqlite_insert(db, "users", u2)

    let rows = sqlite_query(db, "users")
    assert_eq(rows.len(), 2, "SQLite must store 2 rows")
    assert_eq(map_get(rows[0], "name"), "Trong", "First row mismatch")
})

test("SQLite ACID Transactions: Commit & Rollback", fn() {
    let mut db = sqlite_open(":memory:")
    db = sqlite_exec(db, "CREATE TABLE accounts (id INT, balance INT)")
    db = sqlite_insert(db, "accounts", map_set(map_new(), "balance", 1000))

    // Start Transaction
    db = sqlite_begin_transaction(db)
    db = sqlite_insert(db, "accounts", map_set(map_new(), "balance", 5000)) // Tentative change
    
    // Rollback
    db = sqlite_rollback(db)

    let rows_after_rollback = sqlite_query(db, "accounts")
    assert_eq(rows_after_rollback.len(), 1, "Rollback must restore original snapshot of 1 row")
    assert_eq(map_get(rows_after_rollback[0], "balance"), 1000, "Original balance must be preserved")
})

test("MySQL Protocol & Connection Pool", fn() {
    let dsn = "admin:secret_pass@tcp(10.0.0.5:3306)/orders_db?charset=utf8mb4"
    let mut pool = mysql_connect_pool(dsn)

    assert_true(mysql_ping(pool), "MySQL connection pool ping must be healthy")

    let exec_res = mysql_exec(pool, "INSERT INTO orders (total) VALUES (?)", [250])
    pool = map_get(exec_res, "pool")
    assert_eq(map_get(exec_res, "rows_affected"), 1, "1 row affected on insert")
    assert_eq(map_get(pool, "queries_executed"), 1, "Pool query count must increment")
})

test("PostgreSQL Driver & Schema Health", fn() {
    let pg_url = "postgres://pg_user:pg_secret@127.0.0.1:5432/microservice_db?sslmode=disable"
    let pg_client = postgres_connect(pg_url)

    assert_true(postgres_is_healthy(pg_client), "Postgres client must be connected")
    let cfg = map_get(pg_client, "config")
    assert_eq(map_get(cfg, "port"), 5432, "Postgres port must be 5432")
    assert_eq(map_get(cfg, "user"), "postgres", "Postgres default user mismatch")
})

test_summary()
