// ========================================================================
// Nong San Viet (VietCleanAgri) Enterprise Backend Platform
// Main Application Bootstrap & HTTP/2 REST Server
// Dynamic Runtime Configuration via .env & config.json
// ========================================================================

import std.http_router
import std.http2
import std.middleware
import std.metrics
import std.ws
import src.config.database
import src.routes.api_router

// ------------------------------------------------------------------------
// Dynamic Configuration Loader (.env, config.json, and OS Environment)
// ------------------------------------------------------------------------
fn load_app_config() {
    let mut cfg = map_new()
    cfg = map_set(cfg, "port", 9090)
    cfg = map_set(cfg, "workers", 500)

    // Auto-detect public directory: prioritize local ./public, fallback to examples path
    let mut default_public = "public"
    if !file_exists("public/index.html") && file_exists("examples/full_apps/agricultural_ecommerce/public/index.html") {
        default_public = "examples/full_apps/agricultural_ecommerce/public"
    }

    // Auto-detect db path: prioritize local ./data, fallback to examples path
    let mut default_db = "data/agricultural.sqlite"
    if default_public != "public" {
        default_db = "examples/full_apps/agricultural_ecommerce/data/agricultural.sqlite"
    }

    cfg = map_set(cfg, "db_path", default_db)
    cfg = map_set(cfg, "public_dir", default_public)

    // 1. Try reading config.json if present in CWD or app dir
    try {
        if file_exists("config.json") {
            let json_raw = file_read("config.json")
            if json_raw != "" {
                let parsed = json_parse(json_raw)
                if map_has(parsed, "port") { cfg = map_set(cfg, "port", to_int(map_get(parsed, "port"))) }
                if map_has(parsed, "db_path") {
                    let user_db = to_string(map_get(parsed, "db_path"))
                    if user_db == "data/agricultural.sqlite" && default_public != "public" {
                        cfg = map_set(cfg, "db_path", "examples/full_apps/agricultural_ecommerce/data/agricultural.sqlite")
                    } else {
                        cfg = map_set(cfg, "db_path", user_db)
                    }
                }
                if map_has(parsed, "public_dir") {
                    let user_pub = to_string(map_get(parsed, "public_dir"))
                    if user_pub == "public" && default_public != "public" {
                        cfg = map_set(cfg, "public_dir", "examples/full_apps/agricultural_ecommerce/public")
                    } else {
                        cfg = map_set(cfg, "public_dir", user_pub)
                    }
                }
                if map_has(parsed, "workers") { cfg = map_set(cfg, "workers", to_int(map_get(parsed, "workers"))) }
            }
        }
    } catch err {}

    // 2. Try reading .env file if present
    try {
        let env_raw = file_read(".env")
        if env_raw != "" {
            let lines = str_split_lines(env_raw)
            for line in lines {
                let l = trim(line)
                if l != "" && !starts_with(l, "#") && contains(l, "=") {
                    let parts = l.split("=")
                    if len(parts) >= 2 {
                        let k = trim(parts[0])
                        let v = trim(parts[1])
                        if k == "PORT" { cfg = map_set(cfg, "port", to_int(v)) }
                        if k == "DATABASE_PATH" || k == "DB_PATH" { cfg = map_set(cfg, "db_path", v) }
                        if k == "PUBLIC_DIR" { cfg = map_set(cfg, "public_dir", v) }
                        if k == "WORKERS" { cfg = map_set(cfg, "workers", to_int(v)) }
                    }
                }
            }
        }
    } catch err {}

    // 3. Override with OS Environment variables if set
    let env_port = env_get("PORT")
    if env_port != "" && env_port != none && env_port != "none" {
        cfg = map_set(cfg, "port", to_int(env_port))
    }
    let env_db = env_get("DATABASE_PATH")
    if env_db != "" && env_db != none && env_db != "none" {
        cfg = map_set(cfg, "db_path", to_string(env_db))
    }
    let env_pub = env_get("PUBLIC_DIR")
    if env_pub != "" && env_pub != none && env_pub != "none" {
        cfg = map_set(cfg, "public_dir", to_string(env_pub))
    }

    return cfg
}

let app_config = load_app_config()
let port = to_int(map_get(app_config, "port"))
let workers = to_int(map_get(app_config, "workers"))
let db_path = to_string(map_get(app_config, "db_path"))
let public_dir = to_string(map_get(app_config, "public_dir"))

println("========================================================================")
println("Nong San Viet Enterprise Platform — Starting High-Performance Services...")
println("========================================================================")
println("[Config] Listening Port: " + to_string(port))
println("[Config] Database Path:  " + db_path)
println("[Config] Static Assets:  " + public_dir)

// 1. Explicitly enable real-time WebSocket on endpoint /ws
ws_init("/ws")
println("[WebSocket] RFC 6455 Real-Time Engine Initialized on /ws")

// 2. Initialize SQLite Database & Schema Migrations
let mut global_db = db_init_and_migrate(db_path)
println("[Database] SQLite Relational File Initialized: " + db_path)

// 3. Metrics & Observability Counters
let mut m = metrics_registry_new("nong_san_viet")
m = metrics_inc_counter(m, "http_requests_total", 1.0)
m = metrics_inc_counter(m, "database_connections_active", 1.0)

// 4. Verify Health Probe
let health_resp = api_dispatch_request(global_db, "GET", "/api/v1/health", map_new())
println("[Health] Status: " + to_string(map_get(health_resp, "status_code")) + " OK")

println("[Router] Dynamic API Routes Registered:")
println("  * GET  / (Frontend Single Page Application)")
println("  * GET  /style.css (Design System & Stylesheet)")
println("  * GET  /app.js (Frontend Client)")
println("  * GET  /docs (Interactive Swagger UI Explorer)")
println("  * GET  /api/v1/swagger.json")
println("  * GET  /api/v1/live/events")
println("  * GET  /api/v1/health")
println("  * GET  /api/v1/categories")
println("  * GET  /api/v1/cooperatives")
println("  * GET  /api/v1/vouchers")
println("  * GET  /api/v1/products")
println("  * GET  /api/v1/flash_sales")
println("  * GET  /api/v1/reviews")
println("  * POST /api/v1/reviews")
println("  * POST /api/v1/orders/checkout")
println("  * GET  /api/v1/orders/track")
println("  * GET  /api/v1/admin/analytics")
println("========================================================================")
println("Nong San Viet Backend listening on http://0.0.0.0:" + to_string(port) + " [HTTP/1.1, HTTP/2, HTTP/3 Alt-Svc]")
println("========================================================================")

// 5. Multi-Protocol High-Throughput Server Configuration
let server_config = http2_server_config(port, workers)

http_listen(server_config, fn(req) {
    let method = to_string(map_get(req, "method"))
    let path = to_string(map_get(req, "path"))
    let raw_body = to_string(map_get(req, "body"))

    // 1. Serve Static Assets via Pure VietLang std.http_router
    if method == "GET" || method == "HEAD" {
        let static_file = http_serve_static(public_dir, path)
        if static_file != none {
            return static_file
        }
    }

    // 2. Parse JSON body if present
    let mut payload = map_new()
    if raw_body != "" && raw_body != "none" {
        let parsed = json_parse(raw_body)
        if parsed != none {
            payload = parsed
        }
    }

    // 3. Dispatch Dynamic REST API Routes
    return api_dispatch_request(global_db, method, path, payload)
})
