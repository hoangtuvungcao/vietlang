// ========================================================================
// Module: services/notification_service.vl
// Domain-Specific Notification Engine for Nong San Viet Platform
// ========================================================================

import std.email
import std.queue

fn notification_build_order_receipt(order_code: String, customer_name: String, total_amount: Int, items_summary: String) -> String {
    let html = "<div style='font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; border: 1px solid #E2E8F0; border-radius: 8px; overflow: hidden;'>" +
               "<div style='background: #064E3B; color: white; padding: 20px; text-align: center;'>" +
               "<h2 style='margin: 0;'>XÁC NHẬN ĐƠN HÀNG NÔNG SẢN VIỆT</h2>" +
               "<p style='margin: 5px 0 0 0; opacity: 0.8;'>Mã đơn: #" + order_code + "</p>" +
               "</div>" +
               "<div style='padding: 24px; color: #1E293B; line-height: 1.6;'>" +
               "<p>Kính chào <strong>" + customer_name + "</strong>,</p>" +
               "<p>Hệ thống Nông Sản Việt đã ghi nhận đơn hàng chuẩn ACID của bạn:</p>" +
               "<div style='background: #F8FAFC; padding: 16px; border-radius: 6px; margin: 16px 0;'>" +
               "<p style='margin: 0;'><strong>Nông sản:</strong> " + items_summary + "</p>" +
               "<p style='margin: 8px 0 0 0;'><strong>Tổng thanh toán:</strong> <span style='color: #059669; font-weight: bold;'>" + to_string(total_amount) + " VNĐ</span></p>" +
               "</div>" +
               "<p>Đơn hàng sẽ được đóng gói và vận chuyển xe lạnh từ Hợp Tác Xã trong thời gian sớm nhất.</p>" +
               "</div>" +
               "</div>"
    return html
}

fn notification_queue_order_email(queue_instance, customer_email: String, order_code: String, customer_name: String, total_amount: Int, items_summary: String) {
    let body_html = notification_build_order_receipt(order_code, customer_name, total_amount, items_summary)
    let mail = email_new("donhang@nongsanviet.vn", customer_email, "Xác nhận đơn hàng #" + order_code)
    let mail = email_set_html(mail, body_html)
    return queue_push(queue_instance, "send_email", mail)
}
