// ========================================================================
// Module: controllers/admin_controller.vl
// Admin Dashboard Metrics & Inventory Health Analytics
// ========================================================================

import std.http_router
import examples.full_apps.agricultural_ecommerce.src.repositories.order_repo
import examples.full_apps.agricultural_ecommerce.src.repositories.product_repo

fn handle_admin_analytics(db) {
    let orders = order_repo_get_all(db)
    let products = product_repo_get_all(db)

    let mut total_revenue = 0
    let mut i = 0
    while i < orders.len() {
        let o = orders[i]
        total_revenue = total_revenue + map_get(o, "total")
        i = i + 1
    }

    let mut low_stock_items = []
    let mut j = 0
    while j < products.len() {
        let p = products[j]
        if map_get(p, "stock") < 100 {
            low_stock_items = low_stock_items.push(p)
        }
        j = j + 1
    }

    let mut data = map_new()
    data = map_set(data, "total_orders", orders.len())
    data = map_set(data, "total_revenue", total_revenue)
    data = map_set(data, "total_products", products.len())
    data = map_set(data, "low_stock_count", low_stock_items.len())
    data = map_set(data, "low_stock_items", low_stock_items)

    return data
}
