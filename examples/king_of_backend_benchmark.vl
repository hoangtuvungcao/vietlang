// ===================================================
// VietLang King of Backend Benchmark & Capability Suite
// Proving Superiority in High-Throughput Modern Backend:
// - Redis-level In-Memory Store with Atomic INCR & Hashes (std.kv_store)
// - Kafka-level Distributed Stream with Offset Batching (std.stream)
// - Webhook Cryptography & Secret Payload Encryption (std.crypto_advanced)
// - Onion Middleware Pipeline & Security Headers (std.http_pipeline)
// - URL Encoding & CIDR IP Shieldinge
// ===================================================

import std.test
import std.security
import std.kv_store
import std.stream
import std.crypto_advanced
import std.http_pipeline

suite("King of Backend Capability Suite")

test("In-Memory KV Store: Atomic INCR & Hash Operations", fn() {
    let mut store = kv_store_new()
    
    // Test atomic counter
    let res1 = kv_incr(store, "api_rate_count", 5)
    store = map_get(res1, "store")
    assert_eq(map_get(res1, "value"), 5, "Counter must be 5")

    let res2 = kv_incr(store, "api_rate_count", 1)
    store = map_get(res2, "store")
    assert_eq(map_get(res2, "value"), 6, "Counter must be 6")

    // Test Hash maps (HSET / HGET)
    store = kv_hset(store, "user:1001", "name", "Trong")
    store = kv_hset(store, "user:1001", "role", "Lead Architect")

    let name = kv_hget(store, "user:1001", "name")
    let role = kv_hget(store, "user:1001", "role")
    assert_eq(name, "Trong", "Hash field name mismatch")
    assert_eq(role, "Lead Architect", "Hash field role mismatch")
})

test("Distributed Stream Engine: Partitioned Log & Offsets", fn() {
    let mut stream = stream_engine_new()
    
    // Ingest events
    let p1 = stream_publish(stream, "orders_stream", map_set(map_new(), "id", "ord_001"))
    stream = map_get(p1, "engine")
    assert_eq(map_get(p1, "offset"), 0, "First event offset must be 0")

    let p2 = stream_publish(stream, "orders_stream", map_set(map_new(), "id", "ord_002"))
    stream = map_get(p2, "engine")
    assert_eq(map_get(p2, "offset"), 1, "Second event offset must be 1")

    let p3 = stream_publish(stream, "orders_stream", map_set(map_new(), "id", "ord_003"))
    stream = map_get(p3, "engine")
    assert_eq(map_get(p3, "offset"), 2, "Third event offset must be 2")

    // Consumer group polling from offset 1 with batch size 2
    let batch = stream_consume_from(stream, "orders_stream", 1, 2)
    assert_eq(batch.len(), 2, "Batch size must be 2")
    let first_in_batch = batch[0]
    assert_eq(map_get(first_in_batch, "offset"), 1, "First in batch must be offset 1")
})

test("Enterprise Cryptography: Webhook Signatures & Secret Payloads", fn() {
    let webhook_secret = "whsec_live_998877665544332211"
    let raw_payload = "{\"event\":\"payment.succeeded\",\"amount\":5000000}"
    let signature = hmac_sha256(raw_payload, webhook_secret)

    // Verify valid webhook
    let is_valid = crypto_verify_webhook(raw_payload, signature, webhook_secret)
    assert_true(is_valid, "Valid webhook signature must pass")

    // Verify tampered webhook fails
    let is_tampered = crypto_verify_webhook("{\"event\":\"payment.succeeded\",\"amount\":100}", signature, webhook_secret)
    assert_false(is_tampered, "Tampered webhook payload must be rejected")

    // Secret Payload Encryption & Decryption
    let enc_key = "SuperSecretEncryptionKey32Chars!"
    let sensitive_data = map_set(map_set(map_new(), "credit_card", "4111-2222-3333-4444"), "cvv", "123")
    let encrypted_b64 = crypto_encrypt_payload(sensitive_data, enc_key)

    let decrypted = crypto_decrypt_payload(encrypted_b64, enc_key)
    assert_eq(map_get(decrypted, "credit_card"), "4111-2222-3333-4444", "Decrypted card mismatch")
    assert_eq(map_get(decrypted, "cvv"), "123", "Decrypted CVV mismatch")
})

test("HTTP Pipeline: Security Headers & IP Shielding", fn() {
    let pipeline = http_pipeline_new()
    let response = http_build_response(200, map_set(map_new(), "status", "secure"))
    
    let headers = map_get(response, "headers")
    assert_eq(map_get(headers, "X-Frame-Options"), "DENY", "X-Frame-Options missing")
    assert_eq(map_get(headers, "X-Content-Type-Options"), "nosniff", "nosniff missing")
    assert_true(map_has(headers, "Content-Security-Policy"), "CSP missing")

    // IP in CIDR check
    assert_true(ip_in_cidr("192.168.1.50", "192.168.1.0/24"), "Subnet match should pass")
    assert_false(ip_in_cidr("10.0.0.1", "192.168.1.0/24"), "Different subnet must return false")
})

test("URL Encoding & Decoding", fn() {
    let raw = "Hello World & VietLang 2026!"
    let encoded = url_encode(raw)
    let decoded = url_decode(encoded)
    assert_eq(decoded, raw, "URL encode-decode roundtrip failed")
})

test_summary()
