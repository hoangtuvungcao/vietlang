import std.test
import std.security
import std.telemetry
import std.migration
import std.event_bus
import std.health
import std.rate_limiter
import std.circuit_breaker
import std.websocket
import std.jwt
import std.orm
import std.queue

suite("Comprehensive Production Backend Suite")

test("Security: Salted Password Hashing & Verification", fn() {
    let password = "SuperSecretPassword2026"
    let hash = security_hash_password(password)

    assert_true(security_verify_password(password, hash), "Password verification failed")
    assert_false(security_verify_password("WrongPassword", hash), "Wrong password should fail")
})

test("Security: Constant-Time String Comparison", fn() {
    let a = "a1b2c3d4e5f6"
    let b = "a1b2c3d4e5f6"
    let c = "a1b2c3d4e5f7"

    assert_true(security_constant_time_compare(a, b), "Identical strings must return true")
    assert_false(security_constant_time_compare(a, c), "Different strings must return false")
})

test("Security: HTML Input Sanitization", fn() {
    let dirty = "<script>alert('xss')</script>"
    let safe = security_sanitize_html(dirty)
    assert_false(safe.contains("<script>"), "HTML tags must be escaped")
    assert_true(safe.contains("&lt;script&gt;"), "Escaped characters missing")
})

test("Distributed Tracing: Spans & Context Propagation", fn() {
    let root_ctx = trace_context_new("payment_service")
    let child_span = trace_create_child_span(root_ctx, "process_card_charge")
    
    assert_eq(map_get(child_span, "trace_id"), map_get(root_ctx, "trace_id"), "TraceID must propagate to child")
    assert_eq(map_get(child_span, "parent_span_id"), map_get(root_ctx, "span_id"), "Parent SpanID mismatch")

    let finished_span = trace_end_span(child_span)
    assert_true(map_has(finished_span, "duration_us"), "Finished span must record microsecond duration")

    let headers = trace_inject_headers(finished_span)
    assert_true(map_has(headers, "X-Trace-Id"), "Missing X-Trace-Id header")
})

test("Database Schema Migrations", fn() {
    let mut engine = migration_engine_new()
    engine = migration_add_step(engine, "001_create_users", "CREATE TABLE users (id INT, email TEXT);", "DROP TABLE users;")
    engine = migration_add_step(engine, "002_create_orders", "CREATE TABLE orders (id INT, total FLOAT);", "DROP TABLE orders;")

    let migrated = migration_run_all(engine)
    let applied = map_get(migrated, "applied")
    assert_eq(applied.len(), 2, "All migrations should be applied")
})

test("Event-Driven Pub/Sub Bus", fn() {
    let mut bus = event_bus_new()
    bus = event_subscribe(bus, "user.registered", "SendWelcomeEmail")
    bus = event_subscribe(bus, "user.registered", "ProvisionStorage")

    let payload = map_set(map_set(map_new(), "user_id", 42), "email", "client@example.com")
    let res = event_publish(bus, "user.registered", payload)
    let evt = map_get(res, "event")

    assert_eq(map_get(evt, "listeners_notified"), 2, "Must notify both subscribers")
    assert_eq(map_get(evt, "topic"), "user.registered", "Topic mismatch")
})

test("Kubernetes Health & Readiness Probes", fn() {
    let mut hc = health_checker_new("order_api")
    hc = health_add_check(hc, "database", true)
    hc = health_add_check(hc, "redis", true)

    let rep1 = health_get_report(hc)
    assert_eq(map_get(rep1, "status"), "UP", "Service should be UP when all checks pass")

    // Simulate database failure
    hc = health_add_check(hc, "database", false)
    let rep2 = health_get_report(hc)
    assert_eq(map_get(rep2, "status"), "DOWN", "Service should be DOWN when a component fails")
})

test_summary()
