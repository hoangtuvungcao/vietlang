// ===================================
// VietLang -- New Features Test
// Compound assignment, try/catch, string ops, array ops
// ===================================

println("=== New Features Test ===\n")

// --- Compound Assignment ---
println("--- Compound Assignment ---")
let mut x = 10
x += 5
println("10 += 5 = " + to_string(x))
assert(x == 15)

x -= 3
println("15 -= 3 = " + to_string(x))
assert(x == 12)

x *= 2
println("12 *= 2 = " + to_string(x))
assert(x == 24)

x /= 4
println("24 /= 4 = " + to_string(x))
assert(x == 6)

x %= 4
println("6 %= 4 = " + to_string(x))
assert(x == 2)

// --- Try/Catch ---
println("\n--- Try/Catch ---")

try {
    let result = 10 / 0
    println("Should not reach here")
} catch err {
    println("Caught error: " + err)
}

try {
    throw("Custom error message")
} catch err {
    println("Caught throw: " + err)
}

// Nested try/catch
try {
    try {
        throw("inner error")
    } catch inner_err {
        println("Inner caught: " + inner_err)
        throw("outer error from inner")
    }
} catch outer_err {
    println("Outer caught: " + outer_err)
}

// --- String Character Operations ---
println("\n--- String Char Ops ---")

let s = "VietLang"
println("char_at(0): " + char_at(s, 0))
assert(char_at(s, 0) == "V")

println("char_at(4): " + char_at(s, 4))
assert(char_at(s, 4) == "L")

println("char_code('A'): " + to_string(char_code("A")))
assert(char_code("A") == 65)

println("from_char_code(86): " + from_char_code(86))
assert(from_char_code(86) == "V")

println("substring(s, 0, 4): " + substring(s, 0, 4))
assert(substring(s, 0, 4) == "Viet")

println("substring(s, 4): " + substring(s, 4))
assert(substring(s, 4) == "Lang")

println("str_repeat('ab', 3): " + str_repeat("ab", 3))
assert(str_repeat("ab", 3) == "ababab")

// --- Parse Int/Float ---
println("\n--- Parse Int/Float ---")
let n = parse_int("42")
println("parse_int('42') = " + to_string(n))
assert(n == 42)

let f = parse_float("3.14")
println("parse_float('3.14') = " + to_string(f))

let bad = parse_int("not_a_number")
println("parse_int('not_a_number') = " + to_string(bad))
assert(bad == none)

// --- Array Operations ---
println("\n--- Array Operations ---")

let arr = [5, 3, 1, 4, 2]
let sorted = sort(arr)
println("sort([5,3,1,4,2]): " + to_string(sorted))
assert(sorted == [1, 2, 3, 4, 5])

let sliced = slice(sorted, 1, 4)
println("slice([1,2,3,4,5], 1, 4): " + to_string(sliced))
assert(sliced == [2, 3, 4])

let idx = index_of(sorted, 3)
println("index_of([1,2,3,4,5], 3): " + to_string(idx))
assert(idx == 2)

let nested = [[1, 2], [3, 4], [5]]
let flattened = flat(nested)
println("flat([[1,2],[3,4],[5]]): " + to_string(flattened))
assert(flattened == [1, 2, 3, 4, 5])

// --- System ---
println("\n--- System ---")
println("Platform: " + platform())
println("Arch: " + arch())

// --- Range ---
println("\n--- Range ---")
let r = range(0, 5)
println("range(0,5): " + to_string(r))
assert(r == [0, 1, 2, 3, 4])

let r2 = range(0, 10, 2)
println("range(0,10,2): " + to_string(r2))
assert(r2 == [0, 2, 4, 6, 8])

println("\n=== All new feature tests passed! ===")
