// ===================================
// VietLang - Backend API Example
// ===================================
// This demonstrates the syntax for backend development
// (HTTP server features will be implemented in Phase 3)

// --- Data Models ---
struct User {
    id: Int,
    name: String,
    email: String,
    active: Bool
}

struct ApiResponse {
    status: Int,
    message: String
}

// --- Service Layer ---
fn create_user(name: String, email: String) -> User {
    let user = User {
        id: 1,
        name: name,
        email: email,
        active: true
    }
    println("[LOG] Created user: " + user.name + " <" + user.email + ">")
    return user
}

fn validate_email(email: String) -> Bool {
    return email.contains("@")
}

fn process_request(method: String, path: String) {
    println("[REQUEST] " + method + " " + path)
    
    let status = match method {
        "GET" => 200,
        "POST" => 201,
        "DELETE" => 204,
        _ => 405
    }
    
    let msg = match method {
        "GET" => "OK",
        "POST" => "Created",
        "DELETE" => "No Content",
        _ => "Method Not Allowed"
    }
    
    println("  Response: " + to_string(status) + " " + msg)
}

// --- Main ---
println("VietLang Backend Demo")
println("========================\n")

// Validate and create user
let email = "trong@example.com"
if validate_email(email) {
    let user = create_user("Van Trong", email)
    println("User created: " + to_string(user))
} else {
    println("Invalid email!")
}

// Simulate API requests
println("\n--- API Simulation ---")
let methods = ["GET", "POST", "PUT", "DELETE"]
let paths = ["/users", "/users/1", "/users/1/update", "/users/1"]

for i in 0..4 {
    process_request(methods[i], paths[i])
}

// Data processing pipeline
println("\n--- Data Pipeline ---")
let raw_data = [10, 25, 3, 47, 8, 92, 15, 63, 4, 71]
println("Raw data: " + to_string(raw_data))

let processed = raw_data
    .filter(fn(x) { return x > 10 })
    .map(fn(x) { return x * 2 })
println("Filtered (>10) & Doubled: " + to_string(processed))

let total = processed.reduce(fn(acc, x) { return acc + x }, 0)
println("Total: " + to_string(total))

println("\nBackend demo completed!")
